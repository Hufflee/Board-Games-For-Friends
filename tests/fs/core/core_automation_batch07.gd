extends RefCounted
## Пакет07:20карт, приватность, чужой выбор души, отмена атаки, сроки и физические зоны.
const Scenario := preload("res://tests/fs/fs_scenario.gd")
const Check := preload("res://tests/fs/fs_check.gd")
const Cards := preload("res://games/four_souls/logic/fs_consumable_cards.gd")

func _game(t: Check, id: int) -> RefCounted:
	var s := Scenario.new(t).players(3).dlc().current(0).character(0, 821).character(1, 821).character(2, 821) \
		.no_items(0).no_items(1).no_items(2).hand(0, [id, 549]).hand(1, [480, 481]).hand(2, [482]) \
		.monster(0, 423).monster(1, 427).deck_top("monster", [352, 348, 357]).coins(0, 5).build()
	s.g.bonuses.clear()
	return s

func _play(s: RefCounted, id: int) -> void:
	s.ok(0, "loot", {"card": id})
	s.close()

func run(t: Check) -> void:
	t.equal(Cards.IDS.size(), 20, "Пакет07содержит20карт")
	for id in [513, 548, 545]:
		var s = _game(t, id)
		_play(s, id)
		t.equal(s.g.hands[0].size(), 2 if id == 545 else 4, "Мешочек/Йера берут точное число карт после оплаты розыгрыша")
		t.equal(s.zone_of(id), "discard:loot", "Разыгранная карта не копируется")
	for id in [685, 686]:
		var s = _game(t, id)
		_play(s, id)
		s.choose(0, "prevent_damage", {"target": 1})
		s.g._damage_player(1, 1)
		t.equal(s.g.hp[1], 2, "Сердце души предотвращает первую1урона")
		s.g._damage_player(1, 1)
		t.equal(s.g.hp[1], 1, "Предотвращение расходуется один раз")
	var bean = _game(t, 469)
	bean._take(550)
	bean.g.hands[1].append(550)
	bean.ok(1, "loot", {"card": 550})
	_play(bean, 469)
	bean.choose(0, "bean_return")
	t.equal(bean.zone_of(550), "hand:0", "Грабящий Боб забрал выбранную добычу автору отмены")
	t.equal(bean.g.coins[1], 3, "Отменённая добыча не начислила монеты")
	var era = _game(t, 472)
	_play(era, 472)
	era.roll(4)
	era.ok(0, "effect_roll")
	era.close()
	for i in 4:
		era.roll(1)
		t.equal(era.g._card_die(i % 3), 4, "Прогулка меняет следующие четыре броска любого игрока")
	era.roll(2)
	t.equal(era.g._card_die(1), 2, "Пятый бросок снова обычный")
	for cover in [false, true]:
		var key = _game(t, 504)
		_play(key, 504)
		if cover:
			key.choose(0, "key_cover", {"item": 1})
			t.equal(key.g.monsters[1].id, 357, "Ключ открыл верхнего монстра в выбранном слоте")
			t.equal(key.g.monsters[1].under.id, 427, "Накрытая карта сохранена")
		else:
			key.choose(0, "extra_attack")
			t.equal(key.g.attack_left, 2, "Ключ добавляет одну атаку активному игроку")
	var note = _game(t, 519)
	for id in [348, 357, 352]:
		note._take(id)
		note.g.discards.monster.append(id)
	_play(note, 519)
	for id in [348, 357, 352]:
		note.choose(0, "note_monster", {"card": id})
		note.choose(0, "note_place", {"item": 1})
	t.equal(note.g.monsters[1].id, 352, "Записка положила все три выбранные карты")
	t.equal(note.g.monsters[1].under.under.under.id, 427, "Записка сохраняет весь прежний слот")
	var contact = _game(t, 533)
	contact.g.battle = 1
	contact.g.phase = "battle_roll"
	_play(contact, 533)
	t.equal(contact.g.battle, -1, "Экстренный номер отменил атаку")
	t.equal(contact.g.decks.monster.front(), 427, "Отменённый монстр под низом колоды")
	t.equal(contact.g.monsters.size(), 2, "После отмены восполнено пустое место")
	var joker = _game(t, 543)
	_play(joker, 543)
	joker.choose(0, "joker_player", {"target": 1})
	t.equal(joker.g.get_view(0).peek.hands[0].cards, [480, 481], "Джокер открыл выбранную руку владельцу эффекта")
	t.check(joker.g.get_view(2).peek.is_empty() and joker.g.get_view(2).card_choices.is_empty(), "Рука и варианты кражи не переданы третьему игроку")
	joker.choose(0, "joker_take", {"card": 481})
	t.equal(joker.zone_of(481), "hand:0", "Джокер украл выбранную карту")
	var credit = _game(t, 547)
	_play(credit, 547)
	t.equal(credit.g._purchase_cost(0, 0), 0, "Кредитная карта обнулила цену магазина")
	t.equal(credit.g._purchase_cost(0, -1), 10, "Верх колоды не является предметом магазина")
	credit.ok(0, "buy", {"slot": 0})
	credit.close()
	t.equal(credit.g.coins[0], 5, "Покупка не списала монеты")
	t.equal(credit.g._purchase_cost(0, 0), 10, "Вторая покупка снова платная")
	var cancer = _game(t, 552)
	_play(cancer, 552)
	cancer.roll(2, [2])
	t.equal(cancer.g._card_die(0), 3, "Рак прибавляет1кпервому броску владельца в ход")
	t.equal(cancer.g._card_die(0), 2, "Второй бросок без бонуса Рака")
	t.equal(cancer.zone_of(552), "item:0", "Рак остаётся физическим брелоком")
	var holy = _game(t, 553)
	_play(holy, 553)
	holy.choose(0, "holy_card", {"target": 1})
	holy.g.hp[1] = 0
	holy.g._check_deaths()
	holy.close()
	t.equal(holy.g.current, 1, "Спасение другого игрока завершает ход автора Святой карты")
	t.equal(holy.g.coins[1], 3, "За предотвращённую смерть штраф не оплачен")
	t.check(not holy.g.dead[1], "Спасённый игрок жив")
	var gold = _game(t, 568)
	_play(gold, 568)
	gold.g.attack_left = 0
	gold.g.attacked = true
	gold.ok(0, "attack", {"slot": -1})
	gold.close()
	t.equal(gold.g.battle, 0, "Золотой ключ разрешает колоду после исчерпания обычных атак")
	t.equal(gold.g.attack_left, 0, "Бесконечные атаки не создают отрицательный лимит")
	var jail = _game(t, 569)
	_play(jail, 569)
	jail.no(1, "loot", {"card": 480})
	jail._take(40)
	jail.g._gain_item(1, 40)
	jail.no(1, "activate", {"item": 1})
	jail.ok(0, "end")
	jail.close()
	jail.ok(1, "loot", {"card": 480})
	var judgement = _game(t, 641)
	judgement._take(475)
	judgement.g._gain_soul_card(1, {"id": 475, "value": 1})
	_play(judgement, 641)
	judgement.choose(0, "judgement_player", {"target": 1})
	t.equal(judgement.g.actor(), 1, "Осуждённый игрок сам выбирает уничтожаемую душу")
	judgement.no(0, "card_choice", {"index": 0, "revision": judgement.g.revision})
	judgement.choose(1, "judgement_soul")
	t.equal(judgement.g.souls[1], 0, "Суд уничтожил душу")
	t.equal(judgement.zone_of(475), "discard:loot", "Уничтоженная душа попала в свой сброс")
	var world = _game(t, 642)
	_play(world, 642)
	t.equal(world.g.get_view(0).peek.hands.size(), 3, "Мир показывает все руки только владельцу")
	t.check(world.g.get_view(1).peek.is_empty(), "Мир сохраняет приватность чужого клиента")
	world.choose(0, "close_peek")
	t.equal(world.g.hands[0].size(), 3, "Мир после просмотра взял2добычи")
	for face in range(1, 7):
		var rune = _game(t, 679)
		_play(rune, 679)
		rune.roll(face)
		rune.ok(0, "effect_roll")
		rune.close()
		for seat in 3:
			if face in [1, 4, 6]:
				t.equal(rune.g.coins[seat], (5 if seat == 0 else 3) + face, "Пустая руна начисляет каждому напечатанные монеты")
			elif face in [2, 5]:
				t.equal(rune.g.hands[seat].size(), (2 if seat == 1 else 1) + face, "Пустая руна выдаёт каждому напечатанное число добычи")
			else:
				t.equal(rune.g.hp[seat], 0, "Пустая руна нанесла каждому3урона")
	var ehwaz = _game(t, 688)
	ehwaz.g.battle = 0
	_play(ehwaz, 688)
	t.equal(ehwaz.zone_of(427), "discard:monster", "Эваз сбрасывает неатакуемого монстра")
	t.equal(ehwaz.g.monsters[0].id, 423, "Эваз не затрагивает атакуемого монстра")
	t.equal(ehwaz.g.monsters[1].id, 357, "Эваз заменяет сброшенного верхом колоды")
