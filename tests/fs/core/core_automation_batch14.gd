extends RefCounted
## Сорок текстов206–245: общие границы копий, чужого выбора и замен броска.
const Batch := preload("res://tests/fs/core/core_automation_batch13.gd")
const Check := preload("res://tests/fs/fs_check.gd")
const Cards := preload("res://games/four_souls/logic/fs_treasure14_cards.gd")
func _game(t: Check, id: int) -> RefCounted:
	return Batch.new()._game(t, id)
func _item(s: RefCounted, seat: int, id: int) -> void:
	Batch.new()._item(s, seat, id)
func _activate(s: RefCounted) -> void:
	s.ok(0, "activate", {"item": 1})
	s.close()
func _trigger(s: RefCounted, event: String, data: Dictionary = {}) -> void:
	Batch.new()._trigger(s, event, data)
func _die(s: RefCounted, face: int) -> void:
	s.roll(face)
	s.ok(s.g.actor(), "effect_roll")
	s.close()
func run(t: Check) -> void:
	t.equal(Cards.IDS.size(), 40, "Пакет14: сорок текстов")
	var spider = _game(t, 206)
	_trigger(spider, "attack_declared", {"seat": 0, "slot": 0})
	_die(spider, 1)
	spider.choose(0, "monster_damage", {"item": 1})
	t.equal(int(spider.g.monsters[1].hp), 7, "206 можно повредить другого монстра")
	for id in [207, 235]:
		var die = _game(t, id)
		die.g.battle = 0
		die.g.phase = "battle_roll"
		die.g._push({"kind": "roll", "owner": 0, "value": 3}, "battle_roll")
		die.close()
		t.equal(die.g.last_roll, 4, "207/235 добавляют единицу к броску")
	var no = _game(t, 208)
	_item(no, 1, 192)
	no.ok(1, "activate", {"item": 1})
	no.ok(0, "activate", {"item": 1})
	no.close()
	no.choose(0, "cancel_ability14")
	no.close()
	t.equal(no.g.hp, [2, 2, 2], "208 отменяет способность без возврата цены")
	t.check(bool(no.g.items[1][1].tapped), "208 отменённый предмет остаётся повёрнутым")
	var bandage = _game(t, 209)
	_item(bandage, 1, 192)
	bandage.g.items[1][1].tapped = true
	_trigger(bandage, "damage", {"seat": 0, "amount": 1})
	bandage.choose(0, "recharge", {"target": 1, "item": 1})
	bandage.g.items[1][1].tapped = true
	_trigger(bandage, "damage", {"seat": 0, "amount": 1})
	t.check(bool(bandage.g.items[1][1].tapped), "209 только первое событие урона за ход")
	var collar = _game(t, 210)
	collar.g.hp[1] = 0
	collar.g.items[1].append(collar.g._remove_item(0, 1))
	collar.g._push({"kind": "death", "owner": 1}, "turn")
	collar.close()
	_die(collar, 3)
	t.equal(collar.g.hp[1], 1, "210 спасает вне своего хода на1–3")
	var bag = _game(t, 211)
	var top: int = int(bag.g.decks.loot.back())
	_activate(bag)
	bag.choose(0, "peek_deck", {"deck": "loot"})
	t.check(bag.g.get_view(1).peek.is_empty(), "211 приватный просмотр")
	bag.choose(0, "bottom_top14", {"mode": "bottom"})
	t.equal(int(bag.g.decks.loot.front()), top, "211 выбранная карта под низом")
	var exchange = _game(t, 212)
	_item(exchange, 0, 143)
	_item(exchange, 1, 147)
	_trigger(exchange, "roll", {"seat": 1, "value": 2})
	exchange.choose(0, "swap_own14", {"card": 143})
	exchange.choose(0, "swap_other14", {"card": 147})
	t.equal(exchange.g._item_count(0, 147), 1, "212 получен выбранный предмет бросавшего")
	t.equal(exchange.g._item_count(1, 143), 1, "212 второй предмет передан бросавшему")
	var reroll = _game(t, 213)
	reroll.g.battle = 0
	reroll.g._push({"kind": "roll", "owner": 0, "value": 1}, "battle_roll")
	reroll.close()
	reroll.choose(0, "reroll")
	_die(reroll, 5)
	reroll.close()
	t.equal(reroll.g.last_roll, 5, "213 перебросил1 до числовых триггеров")
	var haunt = _game(t, 214)
	haunt.g._damage_player(0, 1)
	t.equal(haunt.g.hp[0], 0, "214 дополнительный урон")
	_trigger(haunt, "death", {"seat": 0})
	haunt.choose(0, "haunt_give", {"target": 2})
	t.equal(haunt.g._item_count(2, 214), 1, "214 передаётся выбранному другому игроку")
	var sack = _game(t, 215)
	sack.g.battle = 0
	_trigger(sack, "roll", {"seat": 1, "value": 5})
	t.check(not sack.g._card_choices().any(func(c): return c.arg.get("item", -1) == 0), "215 не сбрасывает атакуемого монстра")
	sack.choose(0, "replace_monster14", {"item": 1})
	t.check(427 in sack.g.discards.monster, "215 прежний монстр сброшен")
	var slot = _game(t, 216)
	_activate(slot)
	t.equal(slot.g.coins[0], 5, "216 цена3 монеты до броска")
	_die(slot, 4)
	t.equal(slot.g.coins[0], 9, "216 результат3–4 даёт4 монеты")
	t.check(not bool(slot.g.items[0][1].tapped), "216 платная способность не поворачивается")
	var blade = _game(t, 217)
	blade.ok(0, "activate", {"item": 1})
	blade.choose(0, "cost_loot12", {"item": 0})
	blade.close()
	t.equal(blade.g.coins[0], 11, "217 после сброса цены даёт3 монеты")
	var clay = _game(t, 218)
	_item(clay, 1, 143)
	_activate(clay)
	clay.choose(0, "permanent_copy14", {"card": 143, "shop": false})
	t.equal(clay.g.attack[0], 3, "218 копирует постоянную атаку")
	clay.g._end_turn()
	clay.close()
	t.equal(int(clay.g.items[0][1].id), 143, "218 копия сохраняется после конца хода")
	clay.g._destroy_item(0, 1)
	t.check(218 in clay.g.discards.treasure, "218 в сброс ушёл физический пластилин")
	var pay = _game(t, 219)
	_item(pay, 1, 143)
	pay.no(0, "activate", {"item": 1}, "219 недостаточно монет")
	pay.g._gain_coins(0, 2)
	_activate(pay)
	pay.choose(0, "steal", {"target": 1, "item": 1})
	t.equal(pay.g.coins[0], 0, "219 десять монет оплачены")
	t.equal(pay.g._item_count(0, 143), 1, "219 украден предмет под контролем игрока")
	var placebo = _game(t, 220)
	_item(placebo, 1, 192)
	_activate(placebo)
	placebo.choose(0, "copy_ability14", {"card": 192, "shop": false})
	placebo.choose(0, "damage", {"target": 2})
	t.equal(placebo.g.hp[2], 1, "220 копирует способность с новыми целями")
	t.check(not bool(placebo.g.items[1][1].tapped), "220 оригинальный предмет не поворачивается")
	var fingers = _game(t, 221)
	fingers.g._turn_allowances()
	t.equal(fingers.g.free_loot, 2, "221 дополнительный розыгрыш")
	fingers.g.battle = 0
	fingers.g._push({"kind": "roll", "owner": 0, "value": 6}, "battle_roll")
	fingers.close()
	t.equal(int(fingers.g.monsters[0].hp), 6, "221 первый успешный бросок наносит дополнительный урон")
	var restock = _game(t, 222)
	var old: int = int(restock.g.shop[0])
	_trigger(restock, "turn_start", {"seat": 0})
	restock.choose(0, "discard_shop14", {"item": 0})
	t.check(old in restock.g.discards.treasure, "222 выбранный предмет сброшен")
	t.check(not restock.g._card_choices().any(func(c): return c.arg.get("op", "") == "discard_shop14" and int(c.arg.get("item", -1)) == 0), "222 новая замена не выбирается повторно")
	restock.choose(0, "skip_choice")
	var rag = _game(t, 223)
	_trigger(rag, "damage", {"seat": 0, "amount": 2})
	t.equal(rag.g.hands[0].size(), 4, "223 одна карта за событие урона")
	var box = _game(t, 224)
	_item(box, 2, 143)
	_activate(box)
	box.choose(0, "swap_source14", {"target": 2, "item": 1})
	t.equal(box.g._item_count(0, 143), 1, "224 получен чужой предмет")
	t.equal(box.g._item_count(2, 224), 1, "224 коробка передана взамен")
	var bean = _game(t, 225)
	_trigger(bean, "damage", {"seat": 0, "amount": 1})
	_die(bean, 1)
	t.equal(bean.g.hp, [2, 1, 1], "225 на1–3 урон каждому другому игроку")
	var belly = _game(t, 226)
	belly.g._turn_allowances()
	t.equal(belly.g.free_loot, 2, "226 дополнительный розыгрыш")
	belly.g.character_ready[0] = false
	_trigger(belly, "damage", {"seat": 0, "amount": 1})
	belly.choose(0, "ready_character")
	t.check(bool(belly.g.character_ready[0]), "226 необязательная перезарядка персонажа")
	var blank = _game(t, 227)
	_activate(blank)
	blank.ok(0, "loot", {"card": 549})
	blank.close()
	t.equal(blank.g.coins[0], 10, "227 две копии монетного эффекта")
	t.equal(blank.g.discards.loot.count(549), 1, "227 в сбросе одна физическая карта")
	blank.inv("227 копия существует только на стеке")
	var curse = _game(t, 228)
	curse.g._gain_coins(0, -8)
	curse.g.battle = 0
	curse.g._push({"kind": "roll", "owner": 0, "value": 3}, "battle_roll")
	curse.close()
	t.equal(curse.g.last_roll, 4, "228 без монет получает бонус броска")
	curse.g.discards.loot.append_array(curse.g.hands[0])
	curse.g.hands[0].clear()
	curse.g._refresh_passive_stats()
	t.equal(curse.g.attack[0], 2, "228 без карт получает бонус атаки")
	var discount = _game(t, 229)
	t.equal(discount.g._purchase_cost(0, 0), 5, "229 магазин дешевле на5")
	t.equal(discount.g._purchase_cost(0, -1), 10, "229 верхняя карта колоды без скидки")
	var knife = _game(t, 230)
	t.equal(knife.g.attack[0], 2, "230 постоянная атака")
	_trigger(knife, "attack_roll", {"seat": 0, "value": 6})
	t.equal(knife.g.hp, [2, 1, 1], "230 своя боевая6 повреждает остальных")
	var payout = _game(t, 231)
	_trigger(payout, "roll", {"seat": 2, "value": 1})
	t.equal(payout.g.hands[0].size(), 4, "231 добыча за чужую1")
	var sacred = _game(t, 232)
	sacred.g.battle = 0
	sacred.g._push({"kind": "roll", "owner": 0, "value": 1}, "battle_roll")
	sacred.close()
	sacred.choose(0, "sacred_six14")
	sacred.close()
	t.equal(sacred.g.last_roll, 6, "232 заменяет1 на конечную6")
	var penta = _game(t, 233)
	penta.g._push({"kind": "roll", "owner": 1, "value": 3}, "turn")
	_activate(penta)
	penta.choose(0, "roll", {"amount": 1})
	t.equal(int(penta.g.stack.back().value), 4, "233 добавляет1 чужому броску")
	var sword = _game(t, 234)
	t.equal(sword.g.attack[0], 2, "234 постоянная атака")
	_trigger(sword, "combat_monster_damage", {"seat": 0, "card": 423, "amount": 1})
	sword.choose(0, "damage", {"target": 1})
	t.equal(sword.g.hp[1], 1, "234 боевой урон монстру вызывает урон другому игроку")
	var map = _game(t, 236)
	_trigger(map, "turn_end", {"seat": 0})
	t.equal(map.g.peek.cards.size(), 4, "236 четыре сокровища в конце хода")
	t.check(map.g.get_view(2).peek.is_empty(), "236 просмотр приватный")
	var habit = _game(t, 237)
	_item(habit, 0, 192)
	habit.ok(0, "activate", {"item": 2})
	habit.close()
	t.equal(habit.g.coins[0], 9, "237 монета за свою активацию")
	var flush = _game(t, 238)
	var original: Array = flush.g.shop.duplicate()
	_activate(flush)
	flush.choose(0, "flush_mode14", {"mode": "treasure"})
	t.check(original.all(func(id): return id in flush.g.decks.treasure), "238 магазин перемещён под низ")
	flush.inv("238 все карты сохранены")
	var lure = _game(t, 239)
	_activate(lure)
	lure.choose(0, "force_monster14", {"item": 1})
	lure.no(0, "end", null, "239 нельзя закончить при возможной атаке")
	lure.no(0, "attack", {"slot": 0}, "239 выбран другой монстр")
	lure.ok(0, "attack", {"slot": 1})
	lure.close()
	t.check(lure.g._forced_monsters14.is_empty(), "239 обязанность выполнена после начала атаки")
	var baggy = _game(t, 240)
	baggy.g._draw_loot(0, 5)
	_trigger(baggy, "turn_end", {"seat": 0})
	t.equal(baggy.g.hands[0].size(), 10, "240 восемь карт в конце хода дают ещё2")
	var cannon = _game(t, 241)
	_item(cannon, 1, 143)
	_activate(cannon)
	cannon.choose(0, "glass_destroy14", {"card": 143})
	_die(cannon, 1)
	t.check(143 in cannon.g.discards.treasure and 241 in cannon.g.discards.treasure, "241 другой предмет и пушка уничтожены")
	t.equal(cannon.g.hands[0].size(), 5, "241 после собственного уничтожения добыча2")
	var jar = _game(t, 242)
	_trigger(jar, "roll", {"seat": 1, "value": 4})
	t.equal(jar.g._card_choice_owner(), 1, "242 карту выбирает бросавший")
	jar.choose(1, "gift_only13", {"item": 1})
	t.equal(jar.g.hands[0].size(), 4, "242 карта передана владельцу")
	var chest = _game(t, 243)
	chest.g._destroy_item(0, 1)
	t.equal(chest.g.souls[0], 1, "243 уничтоженный сундук становится душой")
	var foot = _game(t, 244)
	foot.g._push({"kind": "roll", "owner": 1, "value": 3}, "turn")
	foot.no(0, "activate", {"item": 1}, "244 не действует на атаку")
	foot.g.stack.clear()
	foot.g.phase = "turn"
	foot.g._begin_resolving({"kind": "item", "card": 120, "owner": 1})
	foot.g._advance_card_automation()
	foot.roll(2)
	foot.ok(1, "effect_roll")
	foot.ok(0, "activate", {"item": 1})
	foot.close()
	foot.choose(0, "roll", {"amount": 2})
	t.equal(int(foot.g.stack.back().value), 4, "244 до2 к небоевому броску")
	var fly = _game(t, 245)
	var revealed: int = int(fly.g.decks.treasure.back())
	_trigger(fly, "roll", {"seat": 1, "value": 6})
	fly.choose(0, "peek_deck", {"deck": "treasure"})
	t.equal(fly.g.get_view(2).peek.cards, [revealed], "245 верхняя карта показана всем")
	fly.choose(0, "fly_top", {"mode": "discard"})
	t.check(revealed in fly.g.discards.treasure, "245 показанная карта сброшена")
