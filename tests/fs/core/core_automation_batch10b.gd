extends RefCounted
## Вторые20карт пакета10: по одному сценарию на механику и разные исходы таблиц.
const Check := preload("res://tests/fs/fs_check.gd")
const First := preload("res://tests/fs/core/core_automation_batch10.gd")
const Cards := preload("res://games/four_souls/logic/fs_secondary_cards.gd")

func _game(t: Check, id: int) -> RefCounted:
	return First.new()._game(t, id)

func _activate(s: RefCounted) -> void:
	s.ok(0, "activate", {"item": 1, "tap": false})
	s.close()

func run(t: Check) -> void:
	t.equal(Cards.IDS.size() + preload("res://games/four_souls/logic/fs_active_cards.gd").IDS.size(), 40, "Текущий пакет содержит40разныхкарт")
	var white = _game(t, 100)
	_activate(white)
	white.choose(0, "white_egg", {"target": 1})
	t.check(1 in white.g.get_view(0).player_attack_targets, "Белый Проглоттид разрешил атаковать игрока с яйцом")
	white._take(101)
	white.g._gain_item(2, 101)
	white.g._place_egg("player", 1, "red")
	t.equal(white.g.attack[1], 3, "Красный Проглоттид усиливает за оба жетона разных источников")
	white.g._emit_passives("death", {"seat": 1, "killer": 0})
	white.close()
	t.equal(white.g.hands[0].size(), 2, "Убийца игрока с яйцом взял1добычу")
	t.equal(white.g._egg_count("player", 1), 0, "Смерть сняла все яйца с игрока")
	var red = _game(t, 101)
	_activate(red)
	red.choose(0, "red_egg", {"zone": "monster", "target": 427})
	t.equal(red.g.coins[0], 0, "Красный жетон оплачен5монетами")
	t.equal(red.g._monster_attack(red.g.monsters[1]), 2, "Яйцо добавляет монстру1атаку")
	var black = _game(t, 102)
	black.g._emit_passives("turn_start")
	black.close()
	black.choose(0, "black_egg", {"zone": "monster", "target": 427})
	black.g._place_egg("player", 1, "red")
	black.g._emit_passives("monster_death", {"seat": 0, "card": 427})
	black.close()
	t.equal(black.g.coins, [7, 3, 5], "Чёрный Проглоттид платит только игрокам без яйца")
	var volt = _game(t, 103)
	volt._take(249)
	volt.g._gain_item(0, 249)
	volt.g.items[0][0].tapped = true
	volt.g.items[0][2].tapped = true
	volt.g._emit_passives("turn_end")
	volt.close()
	volt.choose(0, "nine_recharge", {"item": 0})
	volt.choose(0, "nine_recharge", {"item": 2})
	volt.close()
	t.check(not volt.g.items[0][0].tapped and not volt.g.items[0][2].tapped, "9вольт заряжает два выбранных своих предмета")
	var bible = _game(t, 104)
	bible._take(709)
	bible.g.curses[1].append(709)
	_activate(bible)
	bible.choose(0, "dagaz_curse")
	bible.choose(0, "destroy_curse", {"target": 1, "card": 709})
	t.equal(bible.zone_of(709), "discard:monster", "Библия уничтожила выбранное проклятие")
	var options = _game(t, 105)
	t.equal(options.g.buy_left, 2, "Больше вариантов добавляет одну покупку")
	options.g._emit_passives("turn_start")
	options.close()
	options.choose(0, "peek_deck")
	t.equal(options.g.peek.cards.size(), 2, "Больше вариантов показывает ровно2сокровища")
	t.check(options.g.get_view(1).peek.is_empty(), "Этот просмотр остаётся приватным")
	options.choose(0, "close_peek")
	var ouija = _game(t, 106)
	for id in [352, 348, 357, 700]:
		ouija._take(id)
		ouija.g.decks.monster.append(id)
	_activate(ouija)
	t.equal(ouija.g.get_view(1).peek.cards.size(), 4, "Открытые доской карты видны всем игрокам")
	ouija.choose(0, "ouija_choose", {"card": 700})
	ouija.choose(0, "ouija_place", {"item": 1})
	ouija.close()
	ouija.roll(3)
	ouija.ok(0, "effect_roll")
	ouija.close()
	t.equal(ouija.zone_of(700), "discard:monster", "Выбранное событие доски разрешилось штатно")
	t.check([352, 348, 357].all(func(id): return id in ouija.g.decks.monster.slice(0, 3)), "Остальные открытые карты ушли под низ")
	var lemon = _game(t, 107)
	_activate(lemon)
	for monster: Dictionary in lemon.g.monsters: monster.hp = 3
	lemon.g._emit_passives("attack_roll", {"seat": 1, "count": 1, "value": 2})
	lemon.close()
	t.check(lemon.g.monsters.all(func(monster): return int(monster.hp) == 2), "Лимонный конфуз сработал от чужого броска2накаждогомонстра")
	for id in [108, 118]:
		var s = _game(t, id)
		s.g.monsters[0].hp = 3
		s.g.monsters[1].hp = 5
		s.g.battle = 1
		s.g.phase = "battle_roll"
		s.roll(6)
		s.ok(0, "roll")
		s.close()
		if s.g.phase == "priority": s.close()
		t.equal(s.g.monsters[0].hp, 2, "Нож/Соевое молоко наносят1другому монстру")
		if id == 108: t.equal(s.g.attack[0], 2, "Мамин нож также даёт1атаку")
		else: t.equal(s.g._monster_evasion(s.g.monsters[1]), 4, "Соевое молоко также даёт1защиту монстрам в свой ход")
	for face in [5, 6]:
		var bean = _game(t, 109)
		bean.ok(0, "activate", {"item": 1})
		bean.close()
		bean.roll(face)
		bean.ok(0, "effect_roll")
		bean.close()
		t.equal(bean.g.items[0][1].tapped, face != 6, "Масляный боб заряжается толькона6")
	var key = _game(t, 110)
	key._take(352)
	key.g.decks.monster.append(352)
	_activate(key)
	key.choose(0, "pay_loot_cost")
	key.choose(0, "key_cover", {"item": 1})
	t.equal(key.zone_of(549), "discard:loot", "Папин ключ оплатил карту добычи")
	t.equal(key.g.monsters[1].id, 352, "Папин ключ открыл верхнего монстра в выбранном слоте")
	t.equal(key.g.monsters[1].under.id, 427, "Папин ключ сохранил накрытого монстра")
	var plan = _game(t, 111)
	plan._take(352)
	plan.g.decks.monster.append(352)
	_activate(plan)
	plan.choose(0, "plan_c_monster", {"item": 1})
	plan.close()
	t.equal(plan.zone_of(111), "discard:treasure", "ПланСуничтожендоубийства")
	plan.ok(0, "end")
	plan.close()
	t.check(plan.g.hp.all(func(value): return int(value) == 0), "ПланСубивает всех игроков в конце хода")
	for face in [1, 4]:
		var crooked = _game(t, 113)
		_activate(crooked)
		crooked.choose(0, "crooked_target", {"target": 1})
		crooked.roll(face)
		crooked.ok(0, "effect_roll")
		crooked.close()
		t.equal(crooked.g.coins[1], 6 if face == 1 else 0, "Погнутый пенни удваивает либо забираетвсемонеты")
	var infamy = _game(t, 115)
	infamy.g._damage_player(0, 4, {"combat": true, "value": 1})
	t.equal(infamy.g.hp[0], 2, "Позор предотвращает боевой урон на1")
	var page = _game(t, 116)
	page.g.current = 1
	page.g.battle = 1
	page.g.phase = "battle_roll"
	page.roll(5)
	page.ok(1, "roll")
	page.close()
	t.equal(page.g.actor(), 0, "Потерянная страница спрашивает владельца, а не бросающего")
	page.choose(0, "reroll")
	t.equal(page.g.actor(), 1, "Переброс Страницы выполняет владелец исходного броска")
	page.roll(2)
	page.ok(1, "effect_roll")
	page.close()
	page.close()
	t.equal(page.g.last_roll, 2, "Страница вернула новый настоящий бросок в исходную атаку")
	var skeleton = _game(t, 117)
	t.equal(skeleton.g.attack_left, 99, "Скелетный ключ разрешает99атак")
	var succubus = _game(t, 119)
	succubus.g.current = 1
	succubus.g._turn_allowances()
	_activate(succubus)
	succubus.choose(0, "extra_loot", {"amount": 2})
	succubus.g.character_ready[0] = false
	succubus._take(550)
	succubus.g.hands[0].append(550)
	succubus.ok(0, "loot", {"card": 549})
	succubus.ok(0, "loot", {"card": 550})
	t.equal(succubus.g._bonus_loot_plays[0], 0, "Суккуб дал два собственных ответа в чужой ход")
	t.equal(succubus.g.free_loot, 1, "Чужие дополнительные розыгрыши не расходуют право ходящего")
	t.equal(succubus.g.coins[0], 2, "Дополнительные розыгрыши оплачены3монетами")
	var tail = _game(t, 121)
	tail.g._begin_turn()
	t.equal(tail.g.hands[0].size(), 3, "Хвост Гаппи добавляет1кобычному добору1")
	tail.ok(0, "end")
	tail.close()
	t.equal(tail.g.phase, "discard", "Хвост требует одну карту в конце хода")
	tail.ok(0, "discard", {"card": 549})
	var twenty = _game(t, 123)
	twenty.no(0, "activate", {"item": 1})
	twenty.g.battle = 1
	twenty.g.phase = "battle_roll"
	twenty.roll(2)
	twenty.ok(0, "roll")
	_activate(twenty)
	twenty.choose(0, "roll", {"amount": 2})
	twenty.close()
	t.equal(twenty.g.last_roll, 4, "20/20прибавляет выбранные2толькоатакующему броску")
