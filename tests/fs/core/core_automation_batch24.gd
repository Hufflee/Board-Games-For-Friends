extends "res://tests/fs/core/core_automation_batch21.gd"
## Бонус без ручного вызова, скрытые решения и общие правила комнат.
func _room24(s: RefCounted, id: int) -> void:
	s._take(id)
	s.g.room = id
	s.g._refresh_passive_stats()

func _event24(s: RefCounted, id: int) -> void:
	s._take(id)
	s.g._begin_resolving({"kind": "event", "card": id, "owner": 0, "_resume": "turn"})
	s.g._advance_card_automation()

func run(t: Check) -> void:
	var bonus = _game(t, 71)
	bonus.g.bonuses = [694]
	for id in [414, 369, 475]:
		bonus._take(id)
		bonus.g._gain_soul_card(0, {"id": id, "value": 1})
		bonus.g._check_bonuses()
	bonus.close()
	t.equal(int(bonus.g.resolving.get("card", -1)), 694, "694 сам открывает выбор при третьей душе")
	t.check(bonus.g._card_choices().all(func(choice): return int(choice.arg.target) != 0), "694 выбор только среди мест с минимумом душ")
	bonus.choose(0, "bonus_seat24", {"target": 2})
	t.equal(bonus.g.souls, [3, 0, 1], "694 выбранный игрок получил бонусную душу")
	var skull = _game(t, 71)
	_event24(skull, 747)
	skull.close()
	_die(skull, 1)
	skull.close()
	t.equal(skull.g.actor(), 1, "747 передача открыла бросок нового владельца")
	_die(skull, 6)
	t.equal(skull.g.coins, [10, 11, 8], "747 каждый получивший контроль заработал2¢")
	t.equal(skull.zone_of(747), "soul:1", "747 физическое событие стало душой")
	var secret = _game(t, 71)
	_event24(secret, 748)
	secret.choose(1, "vote_cast24", {"target": 2})
	t.check(not secret.g.get_view(0).resolving.has("ballots24"), "748 активный не видит тайные голоса")
	secret.choose(2, "vote_cast24", {"target": 2})
	t.check(not secret.g.get_view(0).resolving.has("guilty24"), "748 виновный не передаётся до догадки")
	secret.choose(0, "vote_guess24", {"target": 2})
	t.equal(secret.g.hp[2], 0, "748 верная догадка убила виновного")
	var guardian = _game(t, 71)
	_event24(guardian, 751)
	guardian.choose(0, "guardian_place24", {"amount": 3})
	t.equal(int(guardian.g.decks.monster[guardian.g.decks.monster.size() - 4]), 751, "751 физическая карта спрятана под тремя верхними")
	_event24(guardian, 751)
	t.equal(guardian.zone_of(751), "soul:0", "751 второе разрешение стало душой")
	var pay = _game(t, 122)
	_room24(pay, 756)
	pay.g.character_ready[0] = false
	pay.ok(0, "character")
	pay.close()
	t.equal(pay.g.coins[0], 5, "756 способность повёрнутого персонажа стоит3¢")
	t.equal(int(pay.g._bonus_loot_plays[0]), 1, "756 платная способность персонажа сохранила результат")
	pay.g.items[0][1].tapped = true
	pay.ok(0, "activate", {"item": 1, "tap": false})
	pay.close()
	t.equal(pay.g.coins[0], 2, "756 ложный аргумент tap не отменяет цену")
	var room_battle = _game(t, 71)
	_room24(room_battle, 757)
	room_battle.ok(0, "room_attack24", {"index": -1})
	room_battle.close()
	room_battle.roll(6)
	room_battle.ok(0, "roll")
	room_battle.close()
	room_battle.choose(0, "coins")
	room_battle.choose(0, "room_cancel24")
	room_battle.close()
	t.equal(room_battle.g.coins[0], 12, "757 получена выбранная награда за урон комнате")
	t.equal(room_battle.g.battle, -1, "757 атака на комнату отменена")
	t.equal(room_battle.g.monsters.size(), 2, "757 комната не стала физическим монстром")
	var sale = _game(t, 71)
	var slots: int = sale.g.shop.size()
	_room24(sale, 758)
	t.equal(sale.g.shop.size(), slots + 2, "758 при входе расширила магазин")
	_trigger(sale, "turn_start", {"seat": 0})
	t.equal(sale.g._purchase_cost(0, 0), 8, "758 первый жетон даёт скидку2¢")
	sale.no(0, "end", null, "758 сначала нужна доступная покупка")
	sale.ok(0, "buy", {"slot": 0})
	sale.close()
	t.equal(int(sale.g.shop[0]), -1, "758 купленный слот не пополняется")
	var blood = _game(t, 71)
	_room24(blood, 760)
	blood.ok(0, "room_activate24", {"index": -1, "card": 760})
	t.equal(blood.g.hp[0], 1, "760 цена здоровья платится до разрешения")
	blood.close()
	t.equal(blood.g.coins[0], 11, "760 монеты выданы после оплаты")
	var blind = _game(t, 71)
	_room24(blind, 763)
	blind._take(457)
	blind.g.decks.monster.append(457)
	blind.ok(0, "attack", {"slot": -1})
	blind.close()
	blind.choose(0, "room_cancel24")
	t.equal(blind.g.battle, -1, "763 даёт отменить открытую атаку до броска")
	var look = _game(t, 71)
	_room24(look, 767)
	look.ok(0, "attack", {"slot": 0})
	look.choose(0, "skip_choice")
	look.choose(0, "room_attack_choice24", {"attack24": {"slot": 0, "over": 0}})
	look.close()
	t.equal(look.g.battle, 0, "767 после просмотра или отказа объявляется ровно одна атака")
	var reroll = _game(t, 71)
	_room24(reroll, 768)
	_attack_roll17(reroll, 1)
	reroll.choose(0, "reroll")
	_die(reroll, 6)
	reroll.close()
	t.equal(int(reroll.g.monsters[0].hp), 7, "768 заменил исходный промах попаданием")
