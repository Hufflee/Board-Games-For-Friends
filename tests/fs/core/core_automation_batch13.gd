extends RefCounted
## Сорок текстов: короткие сценарии, разные владельцы выбора, замены и физическая копия.
const Batch12 := preload("res://tests/fs/core/core_automation_batch12.gd")
const Check := preload("res://tests/fs/fs_check.gd")
const Cards := preload("res://games/four_souls/logic/fs_treasure13_cards.gd")
func _game(t: Check, id: int) -> RefCounted:
	return Batch12.new()._game(t, id)
func _activate(s: RefCounted) -> void:
	s.ok(0, "activate", {"item":1})
	s.close()
func _trigger(s: RefCounted, event: String, data: Dictionary = {}) -> void:
	s.g._emit_passives(event, data)
	s.close()
func _item(s: RefCounted, seat: int, id: int) -> void:
	s._take(id)
	s.g._gain_item(seat, id)
func run(t: Check) -> void:
	t.equal(Cards.IDS.size(), 40, "Пакет13:40карт")
	var dry = _game(t, 164)
	dry.g._damage_player(0, 4)
	t.equal(dry.g.hp[0], 1, "164много урона превращается в1")
	var nickel = _game(t, 165)
	_trigger(nickel, "roll", {"seat":2, "value":5})
	t.equal(nickel.g.coins[0], 11, "165три монеты за чужую5")
	var fish = _game(t, 166)
	_trigger(fish, "death", {"seat":0, "killer":1})
	t.equal(fish.g.coins[0], 16, "166восемь монет до штрафа")
	var paw = _game(t, 167)
	_activate(paw)
	paw.choose(0, "admiration_target", {"target":1})
	t.equal(paw.g._card_choice_owner(), 1, "167отдающий выбирает карту")
	paw.choose(1, "gift_only13", {"item":1})
	t.equal(paw.g.hands[0].size(), 4, "167отданная карта не разыгрывается")
	var diplopia = _game(t, 168)
	_activate(diplopia)
	diplopia.choose(0, "double_draw13", {"target":2})
	diplopia.g._draw_loot(2, 2)
	t.equal(diplopia.g.hands[2].size(), 5, "168удвоен весь добор2до4")
	var copy = _game(t, 169)
	_item(copy, 1, 143)
	_activate(copy)
	copy.choose(0, "copy_passive13", {"target":1, "item":1})
	t.equal(copy.g.attack[0], 3, "169копирует постоянную атаку")
	t.equal(int(copy.g.items[0][1].physical_id13), 169, "169сохраняет номер физической карты")
	copy.inv("В игре две способности143, но разные физические карты")
	copy.g._destroy_item(0, 1)
	t.check(169 in copy.g.discards.treasure and 143 not in copy.g.discards.treasure, "169уничтожение сбрасывает копирующую карту")
	var vote = _game(t, 170)
	_item(vote, 1, 143)
	_activate(vote)
	for seat in 3:
		t.equal(vote.g._card_choice_owner(), seat, "170голосует очередной игрок")
		vote.choose(seat, "vote_item13", {"card":143})
	t.equal(vote.g._item_count(1, 143), 0, "170победивший предмет уничтожен")
	var tie = _game(t, 170)
	_item(tie, 1, 143)
	_item(tie, 2, 147)
	_activate(tie)
	tie.choose(0, "vote_item13", {"card":170})
	tie.choose(1, "vote_item13", {"card":143})
	tie.choose(2, "vote_item13", {"card":147})
	t.equal(tie.g._item_count(0, 170)+tie.g._item_count(1, 143)+tie.g._item_count(2, 147), 3, "170ничья ничего не уничтожает")
	var theft = _game(t, 171)
	_item(theft, 0, 143)
	_item(theft, 0, 147)
	_item(theft, 1, 112)
	theft.ok(0, "activate", {"item":1})
	theft.choose(0, "destroy_cost13", {"card":143})
	theft.choose(0, "destroy_cost13", {"card":147})
	t.check(143 in theft.g.discards.treasure and 147 in theft.g.discards.treasure, "171две цены оплачены до ответов")
	theft.close()
	theft.choose(0, "steal", {"target":1, "item":1})
	t.equal(theft.g._item_count(0, 112), 1, "171после цены украден выбранный предмет")
	var sack = _game(t, 172)
	_activate(sack)
	sack.choose(0, "hand_top", {"item":0})
	t.equal(sack.g.hands[0].size(), 3, "172взята и возвращена ровно1карта")
	t.equal(int(sack.g.decks.loot.back()), 549, "172выбранная карта положена сверху")
	var shop = _game(t, 173)
	shop.g._turn_allowances()
	t.equal(shop.g.buy_left, 2, "173дополнительная покупка")
	shop.ok(0, "inspect_item13")
	t.equal(shop.g.peek.cards, [shop.g.decks.treasure.back()], "173верхнее сокровище без активации")
	t.check(shop.g.get_view(1).peek.is_empty(), "173просмотр приватный")
	shop.choose(0, "close_peek")
	for id in [175, 185]:
		for face in range(1, 7):
			var bag = _game(t, id)
			_activate(bag)
			bag.roll(face)
			bag.ok(0, "effect_roll")
			bag.close()
			t.equal(bag.g.coins[0], 8+(4 if id == 175 and face in [3, 4] else 1 if id == 185 and face <= 2 else 0), "175/185таблица монет")
			t.equal(bag.g.hands[0].size(), 3+(1 if (id == 175 and face <= 2) or (id == 185 and face in [3, 4]) else 0), "175/185таблица добычи")
			t.equal(bag.g.max_hp[0], 3 if id == 185 and face >= 5 else 2, "185здоровье до конца хода")
	var charge = _game(t, 176)
	_item(charge, 1, 143)
	charge.g.items[1][1].tapped = true
	_trigger(charge, "roll", {"seat":2, "value":2})
	charge.choose(0, "recharge", {"target":1, "item":1})
	t.check(not charge.g.items[1][1].tapped, "176перезарядка чужого предмета на2")
	var piggy = _game(t, 177)
	piggy.g.items[0][1].counters = 5
	_trigger(piggy, "damage", {"seat":0, "amount":2})
	t.equal(piggy.g.items[0][1].counters, 1, "177жетоны за урон и трата6")
	t.equal(piggy.g.items[0].size(), 3, "177получено сокровище")
	var razor = _game(t, 178)
	_activate(razor)
	t.equal(razor.g.coins[0], 3, "178цена5монет")
	razor.choose(0, "damage", {"target":2})
	t.equal(razor.g.hp[2], 1, "178выбранная цель получила1урон")
	var stone = _game(t, 179)
	for seat in 3:
		_item(stone, seat, [143, 147, 112][seat])
	_trigger(stone, "turn_start")
	var random_owner: int = stone.g._card_choice_owner()
	stone.choose(random_owner, "chosen_destroy13")
	t.equal(stone.g.items[random_owner].size(), 1 if random_owner != 0 else 2, "179случайный игрок сам выбрал предмет")
	var wafer = _game(t, 180)
	_trigger(wafer, "damage", {"seat":0, "amount":2})
	t.equal(wafer.g.items[0][1].counters, 1, "180один жетон за событие урона")
	_activate(wafer)
	wafer.g._damage_player(0, 1)
	t.equal(wafer.g.hp[0], 2, "180жетон предотвращает следующую единицу")
	var chaos = _game(t, 181)
	_activate(chaos)
	chaos.choose(0, "chaos_mode13", {"mode":"kill"})
	chaos.choose(0, "chaos_kill13", {"target":2})
	t.equal(chaos.g.hp[2], 0, "181смерть выбранного игрока")
	t.check(181 in chaos.g.discards.treasure, "181источник уничтожен")
	for id in [182, 187]:
		var order = _game(t, id)
		_trigger(order, "turn_end")
		var deck: String = "monster" if id == 182 else "loot"
		t.equal(order.g.peek.cards.size(), 4, "182/187четыре верхние карты")
		var first: int = int(order.g.peek.cards[0])
		order.choose(0, "order_card", {"card":first})
		while not order.g.peek.is_empty():
			order.choose(0, "order_card")
		t.equal(int(order.g.decks[deck].back()), first, "182/187выбранная первая карта сверху")
	var shovel = _game(t, 183)
	var tops := {}
	for deck in shovel.g.decks:
		tops[deck] = int(shovel.g.decks[deck].back())
	_activate(shovel)
	for deck in tops:
		t.check(int(tops[deck]) in shovel.g.discards[deck], "183верх каждой колоды сброшен без исполнения")
	var heart = _game(t, 184)
	_trigger(heart, "monster_death", {"seat":2, "card":423})
	t.equal(heart.g.coins[0], 11, "184три монеты за чужое убийство")
	var lust = _game(t, 186)
	_trigger(lust, "turn_end")
	lust.choose(0, "recycle_hand13", {"item":0})
	lust.choose(0, "recycle_hand13", {"item":0})
	lust.choose(0, "skip_choice")
	t.equal(lust.g.hands[0].size(), 3, "186добрано ровно столько, сколько сброшено")
	t.check(549 in lust.g.discards.loot and 480 in lust.g.discards.loot, "186действительно выбранные карты в сбросе")
	var compost = _game(t, 188)
	compost._take(486)
	compost.g.discards.loot.append(486)
	_activate(compost)
	compost.g._draw_loot(2, 1)
	t.equal(int(compost.g.hands[2].back()), 486, "188следующий чужой добор взят из сброса")
	t.equal(compost.g._compost_draws13, 0, "188замена использована единожды")
	var invitation = _game(t, 189)
	_activate(invitation)
	invitation.g.free_loot = 0
	invitation.g.character_ready[0] = false
	invitation.ok(0, "loot", {"card":549})
	invitation.close()
	invitation.ok(0, "loot", {"card":480})
	invitation.close()
	t.check(invitation.g.get_view(0).unlimited_loot, "189разрешает дополнительные карты без перезарядки")
	var sleeping = _game(t, 190)
	_trigger(sleeping, "death", {"seat":0, "killer":1})
	t.equal(sleeping.g.hands[0].size(), 6, "190три добычи до штрафа")
	var collar = _game(t, 191)
	_activate(collar)
	collar.choose(0, "next_hit_shield", {"target":2})
	t.equal(collar.g.hp[0], 1, "191оплачено здоровье, а не получен урон")
	collar.g._damage_player(2, 3)
	t.equal(collar.g.hp[2], 1, "191предотвращены2одного события")
	var blade = _game(t, 192)
	_activate(blade)
	blade.choose(0, "damage", {"target":2})
	t.equal(blade.g.hp[2], 1, "192урон выбранному игроку")
	var feather = _game(t, 193)
	feather._take(348)
	feather.g.discards.monster.append(348)
	_activate(feather)
	feather.choose(0, "monster_top13", {"card":348})
	t.equal(int(feather.g.decks.monster.back()), 348, "193несобытие возвращено на верх")
	var haunt = _game(t, 194)
	t.equal(haunt.g._monster_evasion(haunt.g.monsters[0]), FSData.stat(423, "dc", 4)+1, "194уклонение монстрам")
	_trigger(haunt, "death", {"seat":0})
	haunt.choose(0, "haunt_give", {"target":1})
	t.equal(haunt.g._item_count(1, 194), 1, "194передано до штрафа")
	var cap = _game(t, 195)
	_activate(cap)
	cap.choose(0, "damage_cap13", {"zone":"player", "target":2})
	cap.g._damage_player(2, 4)
	t.equal(cap.g.hp[2], 1, "195следующее событие уменьшено до1")
	for id in [196, 200]:
		var purse = _game(t, id)
		purse.g._complete_turn_start()
		t.equal(purse.g.hands[0].size(), 5, "196/200дополнительный добор шага")
	var rod = _game(t, 197)
	_trigger(rod, "roll", {"seat":2, "value":6})
	rod.choose(0, "roller_damage13")
	t.equal(rod.g.hp[2], 1, "197урон именно бросившему6")
	var box = _game(t, 198)
	_trigger(box, "roll", {"seat":2, "value":4})
	box.choose(0, "optional_loot13")
	box.choose(0, "discard_loot")
	t.equal(box.g.hands[0].size(), 3, "198добор и сброс")
	var crow = _game(t, 201)
	_trigger(crow, "roll", {"seat":1, "value":3})
	crow.choose(0, "crow_reveal13")
	t.check(crow.g.get_view(2).peek.is_empty(), "201чужая рука видна только контроллеру")
	crow.choose(0, "crow_take13", {"item":1})
	t.equal(crow.g.hands[0].size(), 4, "201украдена выбранная карта из просмотренной руки")
	var cat = _game(t, 202)
	t.equal(cat.g.items[0][1].counters, 9, "202начальные9жетонов")
	cat.g._damage_player(0, 3)
	t.equal(cat.g.hp[0], 2, "202предотвращён урон3")
	t.equal(cat.g.items[0][1].counters, 6, "202потрачены3жетона")
	var head = _game(t, 203)
	_activate(head)
	t.equal(head.g.coins[0], 9, "203монета по повороту")
	_trigger(head, "roll", {"seat":2, "value":1})
	head.choose(0, "fly_recharge")
	t.check(not head.g.items[0][1].tapped, "203перезарядка на чужую1")
	var onion = _game(t, 204)
	onion.g._push({"kind":"roll", "owner":1, "value":5}, "turn")
	onion.ok(0, "activate", {"item":1})
	onion.close()
	onion.choose(0, "roll", {"amount":-2})
	t.equal(int(onion.g.stack.back().value), 3, "204выбранное вычитание2")
	var poop = _game(t, 205)
	_activate(poop)
	poop.choose(0, "monster_damage", {"item":1})
	t.equal(int(poop.g.monsters[1].hp), 7, "205урон только выбранному монстру")

	var expiry = _game(t, 169)
	_item(expiry, 1, 143)
	_activate(expiry)
	expiry.choose(0, "copy_passive13", {"target":1, "item":1})
	expiry.g.items[2].append(expiry.g._remove_item(0, 1))
	expiry.g._refresh_passive_stats()
	t.equal(expiry.g.attack[2], 3, "169переданная копия сохраняет текст до конца хода")
	expiry.ok(0, "end")
	expiry.close()
	expiry.close()
	t.equal(expiry.g._item_count(2, 169), 1, "169возвращает исходный текст у нового владельца")
	t.equal(expiry.g.attack[2], 1, "169временная атака снята")
	var prevented = _game(t, 171)
	_item(prevented, 0, 518)
	prevented.ok(0, "activate", {"item":1})
	prevented.choose(0, "destroy_cost13", {"card":518})
	t.check(prevented.g._item_count(0, 518) == 1 and not prevented.g.stack.any(func(e): return e.kind == "item" and int(e.card) == 171), "171замена уничтожения не оплачивает цену")
	var skip_box = _game(t, 198)
	_trigger(skip_box, "roll", {"seat":1, "value":4})
	skip_box.choose(0, "skip_choice")
	t.equal(skip_box.g.hands[0].size(), 3, "198отказ не заставляет сбрасывать")
	var no_shop = _game(t, 171)
	_item(no_shop, 0, 143)
	no_shop.ok(0, "activate", {"item":1})
	no_shop.choose(0, "destroy_cost13", {"card":143})
	no_shop.choose(0, "destroy_cost13", {"card":171})
	no_shop.close()
	t.check(no_shop.g.phase != "effect" or no_shop.g._card_choices().all(func(c): return not bool(c.arg.get("shop", false))), "171не крадёт из магазина")
