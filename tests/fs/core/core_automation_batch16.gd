extends "res://tests/fs/core/core_automation_batch15.gd"
## Сорок текстов287–326: условия урона, чужие решения и порядок после награды.
func _dead16(s: RefCounted) -> void:
	s.g.monsters[0].hp = 0
	s.g._continue_stack()
	s.close()
func _post16(t: Check, id: int) -> RefCounted:
	var s = _monster(t, id)
	_dead16(s)
	return s
func run(t: Check) -> void:
	t.equal(preload("res://games/four_souls/logic/fs_monster16_cards.gd").IDS.size(), 40, "Пакет16: сорок текстов")
	var rag = _monster(t, 287)
	_trigger(rag, "monster_damage", {"seat": 0, "card": 287, "amount": 1})
	rag.choose(0, "damage", {"target": 2})
	t.equal(rag.g.hp[2], 1, "287 активный выбирает получателя урона")
	var entrails = _monster(t, 288)
	entrails.g._monster_entered15(entrails.g.monsters[0])
	entrails.close()
	t.equal(entrails.g.hp[0], 2, "288 активный исключён из случайного урона входа")
	t.equal(int(entrails.g.hp[1]) + int(entrails.g.hp[2]), 2, "288 случайный другой получил2урона")
	var worm = _monster(t, 289)
	worm.g.battle = 0
	_trigger(worm, "attack_miss", {"seat": 0})
	t.equal(worm.g.battle, -1, "289 промах отменяет атаку")
	t.equal(int(worm.g.decks.monster[0]), 289, "289 помещена под низ")
	var broadcast = _monster(t, 290)
	_trigger(broadcast, "monster_death", {"seat": 0, "card": 290})
	broadcast.choose(0, "kill_other16", {"item": 1})
	broadcast.choose(0, "kill_player16", {"target": 1})
	t.equal(broadcast.g.monster_slots, 4, "290 слотов стало на2больше")
	t.equal(broadcast.g.hp[1], 0, "290 выбранный игрок убит")
	var static_monster = _monster(t, 291)
	_trigger(static_monster, "turn_start", {"seat": 0})
	t.equal(int(static_monster.g.hp[0]) + int(static_monster.g.hp[1]) + int(static_monster.g.hp[2]), 5, "291 начало наносит1случайному игроку")
	var guts = _monster(t, 292)
	_trigger(guts, "turn_start", {"seat": 0})
	_die(guts, 1)
	t.check(guts.g._gut_tokens16.has(0), "292 жетон кишки у активного")
	t.equal(guts.g._pvp_defense16(0), 3, "292 защита носителя3")
	var delirium = _monster(t, 423)
	delirium._take(293)
	delirium.g._gain_soul_card(0, {"id": 293, "value": 1})
	delirium.operation_panel()
	delirium.effect(0, "monster_damage", {"item": 0, "amount": 2})
	_die(delirium, 1)
	delirium.close()
	t.equal(int(delirium.g.monsters[0].hp), 2, "293 единица предотвращает исходящий урон")
	var random_item = _monster(t, 423)
	_item(random_item, 0, 143)
	random_item._take(294)
	random_item.g._gain_soul_card(0, {"id": 294, "value": 1})
	t.equal(random_item.g._death_item16(0, -1), 1, "294 штраф выбирает единственный не-вечный предмет случайно")
	var god = _monster(t, 295)
	god.g.battle = 0
	_trigger(god, "attack_roll", {"seat": 0, "value": 1})
	t.equal(god.g.hp, [0, 0, 0], "295 единица убивает всех игроков")
	var portal = _monster(t, 296)
	_trigger(portal, "turn_start", {"seat": 0})
	_die(portal, 6)
	t.equal(int(portal.g.monsters[1].dc), 3, "296 все монстры получили+1защиты")
	var gurgling = _monster(t, 297, {"hp": 2})
	t.equal(gurgling.g._monster_evasion(gurgling.g.monsters[0]), 2, "297 низкое здоровье даёт−1защиты")
	var pride = _monster(t, 298)
	pride.g.battle = 0
	_trigger(pride, "attack_roll", {"seat": 0, "value": 1})
	t.equal(pride.g.monster_slots, 3, "298 единица расширяет ряд")
	var rush = _monster(t, 299, {"hp": 0})
	t.check(rush.g._replace_monster_death(0), "299 смерть заменяется жетоном")
	rush.close()
	t.equal(rush.g.coins[0], 14, "299 предотвращение выдаёт6монет")
	var spiders = _monster(t, 300)
	_trigger(spiders, "monster_damage", {"seat": 0, "card": 300, "amount": 1})
	_trigger(spiders, "monster_death", {"seat": 0, "card": 300})
	spiders.choose(0, "split_damage16", {"zone": "monster", "target": 1})
	t.equal(int(spiders.g.monsters[1].hp), 7, "300 каждый жетон распределяется отдельным уроном")
	var sack = _monster(t, 301)
	_trigger(sack, "monster_death", {"seat": 0, "card": 301})
	_die(sack, 5)
	t.equal(sack.g.monster_slots, 5, "301 результат5расширяет на3")
	var yellow = _monster(t, 302)
	_trigger(yellow, "monster_damage", {"seat": 0, "card": 302, "amount": 1})
	t.equal(int(yellow.g.monsters[0].dc), 4, "302 повреждение снижает защиту")
	var bloat = _monster(t, 303)
	_trigger(bloat, "monster_death", {"seat": 0, "card": 303})
	t.equal(bloat.g.attack_left, 2, "303 добавлена атака")
	t.check(bloat.g._encounter_must_attack(), "303 дополнительная атака обязательна")
	var baby = _monster(t, 304, {"hp": 5})
	baby.g.battle = 0
	baby.g._apply_combat({"kind": "combat", "owner": 0, "card": 304, "hit": true, "damage": 1, "value": 6})
	t.equal(int(baby.g.monsters[0].hp), 5, "304 шестёрка не наносит боевого урона")
	var envy = _monster(t, 305)
	_trigger(envy, "damage", {"seat": 0, "combat": true, "monster": 305, "amount": 1})
	t.equal(envy.g.hp, [2, 1, 1], "305 урон каждому другому игроку")
	var dogma = _monster(t, 306)
	_trigger(dogma, "attack_declared", {"seat": 0, "slot": 0})
	t.check(423 in dogma.g.discards.monster, "306 объявление атаки сбрасывает других монстров")
	var clot = _monster(t, 307)
	var old: Array = clot.g.hands.duplicate(true)
	_trigger(clot, "monster_death", {"seat": 0, "card": 307})
	t.equal(clot.g.hands[1], old[0], "307 руки переданы одновременно влево")
	var little = _monster(t, 308)
	_trigger(little, "monster_damage", {"seat": 0, "card": 308, "amount": 1})
	t.check(not little.g._card_choices().any(func(choice): return int(choice.arg.get("target", -1)) == 0), "308 нельзя выбрать активного")
	little.choose(0, "damage", {"target": 1})
	t.equal(little.g.hp[1], 1, "308 выбранный другой получил урон")
	var pile = _monster(t, 309)
	_trigger(pile, "monster_death", {"seat": 0, "card": 309})
	t.equal(pile.g.hp[0], 2, "309 активный исключён из случайного урона смерти")
	var isaac = _post16(t, 310)
	_die(isaac, 4)
	t.equal(isaac.g.hands[0].size(), 7, "310 награда равна результату кубика")
	t.equal(isaac.g.souls[0], 1, "310 получена физическая душа")
	var lamb = _monster(t, 311)
	_trigger(lamb, "monster_damage", {"seat": 0, "card": 311, "amount": 1})
	t.equal(int(lamb.g.monsters[0].dc), 2, "311 повреждение повышает защиту")
	_trigger(lamb, "monster_death", {"seat": 0, "card": 311})
	t.equal(lamb.g.monster_slots, 4, "311 смерть расширяет на2")
	var beast = _monster(t, 312)
	t.equal(beast.g._permitted_player_attack_targets(), [1, 2], "312 другие игроки доступны для атаки")
	beast.g.dead[1] = true
	beast.g.dead[2] = true
	_trigger(beast, "turn_end", {"seat": 0})
	t.equal(beast.g.winner, 0, "312 единственный живой в конце хода побеждает")
	var hush = _monster(t, 313)
	_trigger(hush, "monster_death", {"seat": 0, "card": 313})
	hush.choose(0, "kill_next16", {"target": 1})
	hush.choose(0, "stop_kills16")
	t.equal(hush.g.hp, [2, 0, 2], "313 можно остановиться после одного из трёх убийств")
	var fly = _monster(t, 314, {"hp": 5, "throws16": 2})
	fly.g.battle = 0
	fly.g._apply_combat({"kind": "combat", "owner": 0, "card": 314, "hit": true, "damage": 1, "value": 6})
	t.equal(int(fly.g.monsters[0].hp), 5, "314 второй бросок не наносит боевого урона")
	var gift = _post16(t, 315)
	t.equal(gift.g.items[0].size(), 2, "315 собственная награда получена до чужого выбора")
	gift.choose(0, "treasure", {"target": 1})
	t.equal(gift.g.items[1].size(), 2, "315 другой получил сокровище")
	var recharge = _post16(t, 316)
	recharge.g.items[1][0].tapped = true
	recharge.choose(0, "recharge_owner16", {"target": 1})
	t.equal(recharge.g._card_choice_owner(), 1, "316 предмет выбирает получатель")
	recharge.choose(1, "recharge", {"target": 1, "item": 0})
	t.check(not recharge.g.items[1][0].tapped, "316 выбранный предмет перезаряжен")
	for id in [317, 321, 322]:
		var loot = _post16(t, id)
		loot.choose(0, "loot", {"target": 1})
		t.equal(loot.g.hands[1].size(), 2 + (3 if id == 317 else 1 if id == 321 else 2), "%d чужая добыча после собственной награды" % id)
	for id in [318, 319]:
		var money = _post16(t, id)
		money.choose(0, "coins", {"target": 1})
		t.equal(money.g.coins[1], 9 + (10 if id == 318 else 5), "%d монеты другому после награды" % id)
	var given_soul = _post16(t, 320)
	given_soul.ok(0, "reward_soul_target", {"target": 1})
	t.equal(given_soul.g.souls[1], 1, "320 душа получена выбранным другим игроком")
	var rolled_money = _post16(t, 323)
	_die(rolled_money, 2)
	rolled_money.close()
	rolled_money.choose(0, "roll_gift16", {"target": 1})
	t.equal(rolled_money.g.actor(), 1, "323 кубик бросает получатель")
	_die(rolled_money, 6)
	t.equal(rolled_money.g.coins[1], 15, "323 результат чужого броска начислен автоматически")
	var vote = _monster(t, 324)
	vote.operation_panel()
	vote.effect(0, "monster_damage", {"item": 0, "amount": 2})
	for seat in 3:
		vote.choose(seat, "whip_vote16", {"whip": seat != 2})
	vote.close()
	t.equal(int(vote.g.monsters[0].hp), 3, "324 большинство Хлыст предотвращает весь урон")
	t.equal(vote.g.hp, [2, 1, 1], "324 не-активные получили1урона")
	var sister = _monster(t, 325)
	_trigger(sister, "roll", {"seat": 2, "value": 1})
	t.equal(sister.g.hands[2].size(), 2, "325 добыча владельцу единицы")
	_trigger(sister, "monster_death", {"seat": 0, "card": 325})
	t.check(sister.g.monsters.any(func(monster): return bool(monster.get("curse_slot16", false))), "325 найденное проклятие занимает отдельный неатакуемый слот")
	var death = _monster(t, 326)
	_trigger(death, "monster_death", {"seat": 0, "card": 423})
	t.equal(int(death.g.hp[0]) + int(death.g.hp[1]) + int(death.g.hp[2]), 4, "326 случайному игроку нанесено3урона с ограничениемHPнулём")
