extends "res://tests/fs/core/core_automation_batch15.gd"
## Общие границы пакета15: порядок участников, платная способность, вечность и физические души.
func run(t: Check) -> void:
	var team = _monster(t, 266, {"hp": 8, "at": 1})
	team.ok(0, "attack", {"slot": 0})
	team.close()
	team.roll(6)
	team.ok(0, "roll")
	team.close()
	team.roll(1)
	team.ok(1, "roll")
	team.close()
	t.equal(team.g.hp, [2, 1, 2], "266 промах наносит урон бросавшему участнику")
	t.equal(team.g.actor(), 2, "266 промах не повторяет участника")
	team.g._end_battle()
	t.equal(team.g._team_queue15, [], "266 отмена очищает участников")
	var tech = _game(t, 248)
	tech.g.items[0][1].counters = 2
	tech.no(0, "activate", {"item": 1, "ability": "kill"})
	t.equal(tech.g.items[0][1].counters, 2, "248 отказ не списывает жетоны")
	var shop = _monster(t, 267)
	_trigger(shop, "monster_death", {"seat": 0, "card": 267})
	shop.choose(0, "eternal_shop15", {"item": 0})
	var id: int = int(shop.g.shop[0])
	shop.g._destroy_physical13(id)
	t.equal(int(shop.g.shop[0]), id, "267 вечный предмет магазина нельзя уничтожить")
	shop.operation_panel()
	shop.effect(0, "take_shop", {"item": 0})
	t.check(bool(shop.g.items[0].back().eternal), "267 покупатель сохраняет вечность предмета")
	var sale = _monster(t, 279)
	t.equal(sale.g._purchase_cost(0, 0), 7, "279 скидка активному")
	t.equal(sale.g._purchase_cost(1, 0), 10, "279 нет скидки вне своего хода")
	t.equal(sale.g._purchase_cost(0, -1), 10, "279 нет скидки на верх колоды")
	var soul = _monster(t, 423)
	soul._take(285)
	soul._take(475)
	soul.g._gain_soul_card(1, {"id": 475, "value": 1})
	soul.g._gain_soul_card(0, {"id": 285, "value": 1})
	soul.close()
	t.equal(soul.g._card_choice_owner(), 0, "285 при получении вне награды ничью разрешает получатель")
	soul.choose(0, "winner15", {"target": 1})
	t.equal(soul.g.winner, 1, "285 победитель выбирается среди лидеров")
	var familiar = _monster(t, 423)
	_item(familiar, 1, 275)
	familiar.ok(0, "attack_familiar15", {"index": 0})
	familiar.close()
	familiar.g._end_battle()
	t.equal(familiar.g.monsters.size(), 2, "275 отмена убирает только виртуальную цель")
	t.check(familiar.g.items[1].any(func(item): return int(item.id) == 275), "275 отмена сохраняет физический предмет владельца")
	familiar.inv("275 отменённая атака")
