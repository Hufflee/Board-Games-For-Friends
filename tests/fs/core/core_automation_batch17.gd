extends "res://tests/fs/core/core_automation_batch16.gd"
## Сорок полных текстов327–366; общая проверка после всей группы.
func _attack_roll17(s: RefCounted, face: int, owner: int = 0, slot: int = 0) -> void:
	s.g.battle = slot
	s.g.phase = "battle_roll"
	s.g._push({"kind": "roll", "owner": owner, "value": face}, "battle_roll")
	s.close()
func run(t: Check) -> void:
	t.equal(preload("res://games/four_souls/logic/fs_monster17_cards.gd").IDS.size(), 40, "Пакет17: сорок текстов")
	var grimace = _monster(t, 327)
	_trigger(grimace, "monster_damage", {"seat": 0, "card": 327, "amount": 1})
	t.equal(grimace.g.hp, [2, 1, 1], "327 повреждение наносит урон всем не-активным")
	var double_die = _monster(t, 328)
	_attack_roll17(double_die, 4)
	_die(double_die, 1)
	t.equal(double_die.g._card_choice_owner(), 1, "328 результат выбирает левый сосед бросавшего")
	double_die.no(0, "card_choice", {"index": 0, "revision": double_die.g.revision})
	double_die.choose(1, "double_choose17", {"item": 0})
	double_die.close()
	t.equal(double_die.g.last_roll, 4, "328 выбранный соседoм кубик стал результатом")
	var wall = _monster(t, 329)
	_trigger(wall, "monster_death", {"seat": 0, "card": 423})
	t.equal(wall.g.monster_slots, 3, "329 гибель другого монстра расширяет ряд")
	var blast = _monster(t, 330)
	_attack_roll17(blast, 1)
	blast.close()
	t.equal(int(blast.g.hp[0]) + int(blast.g.hp[1]) + int(blast.g.hp[2]), 5, "330 вместо промаха только1случайного урона")
	var greed = _monster(t, 331)
	_trigger(greed, "monster_death", {"seat": 0, "card": 423})
	greed.choose(0, "coins")
	t.equal(greed.g.coins[0], 11, "331 необязательные3монеты после смерти монстра")
	var brain = _monster(t, 332)
	var dc: int = int(brain.g.monsters[1].dc)
	_trigger(brain, "roll", {"seat": 2, "value": 3})
	t.equal(int(brain.g.monsters[1].dc), dc - 1, "332 любой результат3снижает защиту всех")
	var flying = _monster(t, 333)
	_trigger(flying, "monster_death", {"seat": 0, "card": 423})
	flying.choose(0, "extra_attack")
	t.equal(flying.g.attack_left, 2, "333 добавочная атака по выбору")
	t.check(not flying.g._encounter_must_attack(), "333 добавочная атака остаётся необязательной")
	var spirit = _monster(t, 334)
	_trigger(spirit, "turn_end", {"seat": 0})
	t.equal(spirit.g.hands[0].size(), 4, "334 лут активному в конце хода")
	var buddy = _monster(t, 335)
	buddy.ok(0, "attack", {"slot": 0})
	buddy.close()
	buddy.choose(0, "partner17", {"target": 2})
	buddy.close()
	buddy.roll(6)
	buddy.ok(0, "roll")
	buddy.close()
	t.equal(buddy.g.actor(), 2, "335 бросает только выбранный напарник")
	buddy.g.monsters[0].hp = 0
	buddy.g._continue_stack()
	buddy.close()
	buddy.close()
	t.equal(buddy.g.items[2].size(), 2, "335 смерть в атаке даёт напарнику сокровище")
	var pvp = _monster(t, 336)
	t.equal(pvp.g._permitted_player_attack_targets(), [1, 2], "336 разрешены атаки других игроков")
	t.equal(pvp.g._printed_monster_reward(336).get("loot"), 1, "336 исправлена напечатанная награда: добыча")
	var belly = _monster(t, 337)
	_trigger(belly, "monster_damage", {"seat": 0, "card": 337, "amount": 1})
	_die(belly, 3)
	t.equal(belly.g.hp, [2, 1, 2], "337 результат3наносит урон левому соседу")
	var cards = _monster(t, 338)
	_trigger(cards, "monster_death", {"seat": 0, "card": 338})
	t.equal(cards.g.peek.cards.size(), 5, "338 просмотрены5карт добычи")
	var first: int = int(cards.g.peek.cards[0])
	while not cards.g.peek.is_empty():
		cards.choose(0, "order_card", {"card": int(cards.g.peek.cards[0])})
	t.equal(int(cards.g.decks.loot.back()), first, "338 порядок задан игроком")
	t.equal(cards.g._printed_monster_reward(338).get("loot"), 2, "338 исправлено число карт награды")
	var team = _monster(t, 339)
	team.ok(0, "attack", {"slot": 0})
	team.close()
	team.roll(6)
	team.ok(0, "roll")
	team.close()
	t.equal(team.g.actor(), 1, "339 после активного атакует следующий игрок")
	var watcher = _monster(t, 340)
	_trigger(watcher, "attack_declared", {"seat": 0, "slot": 1})
	_die(watcher, 2)
	t.equal(watcher.g.hp[0], 1, "340 реагирует на атаку другого монстра")
	var must = _monster(t, 341)
	_trigger(must, "turn_start", {"seat": 0})
	t.check(341 in must.g._forced_monsters14, "341 обязательная атака в начале хода")
	_trigger(must, "monster_death", {"seat": 0, "card": 341})
	must.choose(0, "skip_turn", {"target": 2})
	t.equal(must.g.skipped_turns[2], 1, "341 выбранный игрок пропустит следующий ход")
	var knots = _monster(t, 342)
	for index in 2:
		_trigger(knots, "attack_declared", {"seat": 0, "slot": 1})
	t.equal(knots.g._monster_evasion(knots.g.monsters[0]), 3, "342 каждый жетон даёт защиту")
	t.equal(knots.g._monster_attack(knots.g.monsters[0]), 3, "342 каждый жетон даёт атаку")
	var egg = _monster(t, 343)
	_trigger(egg, "monster_death", {"seat": 0, "card": 343})
	t.check(egg.g._eggs_respawn17.has(0), "343 у активного жетон яйца")
	egg.g.discards.monster.append(int(egg.g.monsters.pop_at(0).id))
	_trigger(egg, "death", {"seat": 0})
	egg.choose(0, "egg_spawn17", {"item": 0})
	t.check(egg.g.monsters.any(func(monster): return int(monster.id) == 343), "343 вернулась из сброса в выбранный слот")
	t.check(not egg.g._eggs_respawn17.has(0), "343 яйца умершего сняты")
	var goat = _monster(t, 344)
	goat.g.battle = 0
	_trigger(goat, "attack_roll", {"seat": 0, "value": 3})
	t.equal(int(goat.g.monsters[0].dc), 6, "344 тройка повышает защиту")
	var low = _monster(t, 345, {"hp": 2})
	t.equal(low.g._monster_evasion(low.g.monsters[0]), 4, "345 при2HP защита снижена")
	var head = _monster(t, 346)
	t.check(head.g._untargetable(346), "346 нельзя атаковать")
	t.equal(head.g._monster_attack(head.g.monsters[1]), 2, "346 аура повышает атаку других монстров")
	var dip = _monster(t, 347, {"lethal_attack_roll": 6})
	_trigger(dip, "monster_death", {"seat": 0, "card": 347})
	t.equal(dip.g._forced_deck_remaining(), 1, "347 шестёрка даёт обязательную атаку колоды")
	var vanilla = _monster(t, 348)
	t.equal(vanilla.g._printed_monster_reward(348), {"treasure": 2, "souls": 1}, "348 только напечатанная награда")
	var charger = _monster(t, 349)
	_trigger(charger, "damage", {"seat": 0, "monster": 349, "combat": true, "amount": 1})
	_attack_roll17(charger, 2, 0, 1)
	t.equal(charger.g.last_roll, 3, "349 следующий бросок атаки получил+1")
	t.check(not charger.g._next_attack_bonus17.has(0), "349 бонус израсходован")
	var fatty = _monster(t, 350)
	_trigger(fatty, "combat_monster_damage", {"seat": 0, "card": 350, "amount": 1})
	_attack_roll17(fatty, 5)
	t.equal(fatty.g.last_roll, 4, "350 следующий бросок атаки получил−1")
	var clot = _monster(t, 351, {"hp": 1})
	_trigger(clot, "damage", {"seat": 0, "monster": 351, "amount": 1})
	t.equal(int(clot.g.monsters[0].hp), 2, "351 после нанесённого урона лечится на1")
	var maggot = _monster(t, 352)
	t.equal(maggot.g._printed_monster_reward(352), {"coins": 3}, "352 только3монеты")
	var face = _monster(t, 353)
	_trigger(face, "monster_damage", {"seat": 0, "card": 353, "amount": 1})
	_attack_roll17(face, 5, 0, 1)
	t.equal(face.g.last_roll, 3, "353 следующий бросок атаки получил−2")
	t.equal(face.g._next_any_attack_bonus17, 0, "353 общий одноразовый штраф израсходован")
	var snap = _monster(t, 354, {"hp": 1})
	t.equal(snap.g._monster_attack(snap.g.monsters[0]), 2, "354 при1HP атака повышена")
	var skull = _monster(t, 355)
	_attack_roll17(skull, 1)
	skull.close()
	t.equal(int(skull.g.monsters[0].hp), 1, "355 единица тоже наносит боевой урон монстру")
	t.equal(skull.g.hp[0], 1, "355 обычный урон промаха тоже получен")
	var glitch = _monster(t, 356)
	glitch.g.battle = 0
	_trigger(glitch, "attack_roll", {"seat": 0, "value": 6})
	glitch.close() # Автоматическая перезарядка стартового822 завершает конец хода.
	t.equal(glitch.g.current, 1, "356 шестёрка автоматически завершает ход")
	t.equal(glitch.g.battle, -1, "356 бой отменён")
	var horde = _monster(t, 357)
	t.equal(horde.g._printed_monster_reward(357), {"treasure": 2, "souls": 2}, "357 две души и2сокровища")
	var mummy = _post16(t, 358)
	t.equal(mummy.g.hands[0].size(), 4, "358 лут выдан до броска возврата")
	_die(mummy, 6)
	t.check(mummy.g.monsters.any(func(monster): return int(monster.id) == 358), "358 вернулась сверху при пополнении своего слота")
	var fistula = _monster(t, 359)
	_trigger(fistula, "monster_damage", {"seat": 0, "card": 359, "amount": 1})
	t.equal(int(fistula.g.monsters[0].dc), 3, "359 повреждение повышает защиту")
	var butt = _monster(t, 360)
	butt.g.attack_left = 0
	butt.g.attacked = true
	_trigger(butt, "monster_death", {"seat": 0, "card": 360})
	butt.choose(0, "extra_blind17")
	t.equal(butt.g.monster_slots, 4, "360 ряд расширен на2")
	butt.no(0, "attack", {"slot": 0})
	t.check(bool(butt.g.get_view(0).blind_only17), "360 добавочная атака доступна только против колоды")
	var spider = _monster(t, 361)
	t.equal(spider.g._printed_monster_reward(361), {"loot": 2, "souls": 1}, "361 только напечатанная награда")
	var horse = _monster(t, 362, {"hp": 0})
	t.check(horse.g._replace_monster_death(0), "362 первая смерть предотвращается")
	t.equal(int(horse.g.monsters[0].dc), 4, "362 после спасения+1защиты по оригиналу")
	t.equal(int(horse.g.monsters[0].at), 1, "362 после спасения−1атаки")
	var hopper = _monster(t, 363, {"hp": 1})
	var hopper_source: Dictionary = hopper.g.monsters[0]
	_trigger(hopper, "monster_damage", {"seat": 0, "card": 363, "amount": 1})
	_die(hopper, 1)
	t.check(int(hopper_source.hp) <= 0, "363 при1HP результат1добивает источник")
	var brown = _monster(t, 364)
	_attack_roll17(brown, 6)
	t.equal(int(brown.g.monsters[0].hp), 1, "364 шестёрка не наносит боевого урона")
	var angel = _monster(t, 365)
	_trigger(angel, "monster_damage", {"seat": 0, "card": 365, "amount": 1})
	angel.choose(0, "damage", {"target": 2})
	t.equal(angel.g.hp[2], 1, "365 урон выбранному живому игроку")
	var doodoo = _monster(t, 366)
	_trigger(doodoo, "monster_damage", {"seat": 0, "card": 366, "amount": 1})
	_die(doodoo, 6)
	t.equal(int(doodoo.g.monsters[0].hp), 2, "366 шестёрка повреждает источник")
	t.check(not doodoo.g._card_automation_active(), "366 собственный урон не создаёт бесконечный повтор условия")
