extends "res://tests/fs/core/core_automation_batch21.gd"
## Пакет22: проверяем напечатанные монеты и физические источники копий.
func run(t: Check) -> void:
	var coins_by_amount := {1: [549, 550, 575, 576, 577], 2: [535, 536, 555, 556, 557, 585, 586, 587], 3: [485, 486, 487, 488, 489, 490, 537, 538, 558, 559, 560, 561], 4: [491, 492, 493, 494, 539, 540, 562, 563], 5: [522, 583]}
	for amount: int in coins_by_amount:
		for id: int in coins_by_amount[amount]:
			t.equal(FSData.coin_loot_value(id), amount, "Монеты%d: напечатанная сумма" % id)
	var editor = _game(t, 71)
	editor.ok(0, "loot", {"card": 549})
	_play21(editor, 500)
	editor.choose(0, "edit_number22", {"card": 549, "index": -1, "value": 2})
	editor.close()
	t.equal(editor.g.coins[0], 10, "500 изменяет выплату только конкретной карты в стеке")
	var gold = _game(t, 143)
	_item(gold, 0, 502)
	gold.close()
	gold.choose(0, "gold_token22", {"target": 0, "item": 1})
	t.equal(gold.g.attack[0], 5, "502 получает постоянную способность помеченного предмета")
	t.equal(int(gold.g.items[0][2].physical_id13), 502, "502 сохраняет физический брелок")
	gold.g._destroy_item(0, 1)
	t.equal(gold.g.attack[0], 1, "502 потерял способности ушедшего предмета")
	gold.inv("Золотой предмет ушёл")
	var rainbow = _game(t, 534)
	_item(rainbow, 1, 143)
	_trigger(rainbow, "turn_start", {"seat": 0})
	_die(rainbow, 4)
	rainbow.choose(0, "rainbow_copy22", {"target": 1, "item": 1})
	t.equal(rainbow.g.attack[0], 3, "534 копирует пассивную атаку другого предмета")
	rainbow.ok(0, "end")
	rainbow.close()
	t.equal(int(rainbow.g.items[0][1].id), 534, "534 возвращает текст в конце хода")
	var copy = _game(t, 122)
	_play21(copy, 564)
	copy.choose(0, "copy_ability14", {"target": 0, "item": 1})
	copy.close()
	t.check(not bool(copy.g.items[0][1].tapped), "564 не поворачивает копируемый предмет")
	t.check(int(copy.g.free_loot) + int(copy.g._bonus_loot_plays[0]) > 0, "564 разрешила настоящую скопированную способность")
	var shield = _game(t, 514)
	shield.g._damage_player(0, 1, {"monster": 423})
	t.equal(shield.g.hp[0], 2, "514 небоевой урон предотвращается пассивно")
	shield.g._damage_player(0, 1, {"monster": 423, "combat": true, "value": 4})
	t.equal(shield.g.hp[0], 1, "514 не предотвращает боевой урон")
