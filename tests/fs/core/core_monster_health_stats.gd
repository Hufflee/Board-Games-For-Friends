extends RefCounted
## Вычисляемые характеристики от HP: реальные границы по изображениям345/354/420, лечение и урон.
const Scenario := preload("res://tests/fs/fs_scenario.gd")
const Check := preload("res://tests/fs/fs_check.gd")

func _game(t: Check, card: int, health: int):
	return Scenario.new(t).players(2).dlc().current(0).character(0, 908).no_items(0).no_items(1) \
		.monster(0, card, {"hp": health}).monster(1, 344).hand(0, [497]).build()

func run(t: Check) -> void:
	var mask = _game(t, 420, 2)
	t.equal(mask.g.get_view(0).monsters[0].dc, 4, "Маска при2HP: защита4")
	mask.roll(5, [5, 6])
	mask.ok(0, "attack", {"slot": 0})
	mask.ok(0, "roll", null)
	mask.close()
	t.equal(mask.g.monsters[0].hp, 1, "Первая5 пробила обычную защиту")
	t.equal(mask.g.get_view(0).monsters[0].dc, 6, "При1HP Маска показывает защиту6")
	t.equal(mask.g.monsters[0].dc, 4, "Исходная защита не переписана условием")
	mask.ok(0, "roll", null)
	mask.close()
	t.equal(mask.g.monsters[0].hp, 1, "Следующая5 не пробивает выросшую защиту6")
	t.equal(mask.g.hp[0], 2, "Промах на5 нанёс ответный урон")
	mask.ok(0, "roll", null)
	mask.close()
	t.equal(mask.zone_of(420), "soul:0", "Шестёрка действительно убила Маску и автоматически выдала душу")
	var gurglings = _game(t, 345, 2)
	t.equal(gurglings.g.get_view(0).monsters[0].dc, 4, "Булькающие при2HP имеют−1защиты")
	gurglings.roll(4)
	gurglings.ok(0, "attack", {"slot": 0})
	gurglings.ok(0, "roll", null)
	gurglings.close()
	t.equal(gurglings.g.monsters[0].hp, 1, "Четвёрка попадает при пониженной защите")
	t.equal(gurglings.g.monsters[0].dc, 5, "Бонус не накапливается в исходномdc")
	gurglings.operation_panel() # Лечение — отдельная операция, Бомба теперь имеет только свой эффект.
	gurglings.effect(0, "monster_hp", {"item": 0, "amount": 2})
	t.equal(gurglings.g.get_view(0).monsters[0].dc, 5, "Лечение до3HP сразу снимает снижение защиты")
	var begotten = _game(t, 354, 1)
	t.equal(begotten.g.get_view(0).monsters[0].at, 2, "Порождённый при1HP показывает+1атаку")
	begotten.roll(1)
	begotten.ok(0, "attack", {"slot": 0})
	begotten.ok(0, "roll", null)
	begotten.close()
	t.equal(begotten.g.hp[0], 1, "Промах получил2урона, не1")
	t.equal(begotten.g.monsters[0].at, 1, "Исходная атака не изменена")
	begotten.operation_panel()
	begotten.effect(0, "monster_hp", {"item": 0, "amount": 1})
	t.equal(begotten.g.get_view(0).monsters[0].at, 1, "Лечение до2HP сразу снимает бонус атаки")
	begotten.inv("После лечения условного бонуса")
