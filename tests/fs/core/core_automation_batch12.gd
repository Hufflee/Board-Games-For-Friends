extends RefCounted
## Пакет12:40сокровищ, законные цели, чужой выбор и единственное событие составного броска.
const Scenario := preload("res://tests/fs/fs_scenario.gd")
const Check := preload("res://tests/fs/fs_check.gd")
const Cards := preload("res://games/four_souls/logic/fs_treasure12_cards.gd")

func _game(t: Check, id: int) -> RefCounted:
	var s := Scenario.new(t).players(3).dlc().current(0).character(0, 821).character(1, 821).character(2, 821) \
		.no_items(0).no_items(1).no_items(2).hand(0, [549, 480, 481]).hand(1, [482, 483, 484]).hand(2, [485]) \
		.item(0, id).monster(0, 423, {"hp": 8}).monster(1, 427, {"hp": 8}).room(-1) \
		.coins(0, 8).coins(1, 9).coins(2, 8).deck_top("treasure", [16, 24, 25, 26, 79, 174, 249]).build()
	s.g.bonuses.clear()
	return s

func _activate(s: RefCounted) -> void:
	s.ok(0, "activate", {"item": 1})
	s.close()

func _trigger(s: RefCounted, event: String, data: Dictionary = {}) -> void:
	s.g._emit_passives(event, data)
	s.close()

func _item(s: RefCounted, seat: int, id: int) -> void:
	s._take(id)
	s.g._gain_item(seat, id)

func run(t: Check) -> void:
	t.equal(Cards.IDS.size(), 40, "Пакет12:40полныхтекстов")
	var abaddon = _game(t, 124)
	t.equal(abaddon.g.attack[0], 4, "124даёт3атаки")
	_trigger(abaddon, "damage", {"seat": 0, "amount": 1})
	t.equal(abaddon.g.hp[0], 0, "124получив урон умирает")
	var athame = _game(t, 125)
	athame.ok(0, "activate", {"item": 1})
	t.equal(athame.g.phase, "effect", "125оплата раньше окна ответа")
	athame.choose(0, "cost_loot12", {"item": 0})
	athame.close()
	t.equal(athame.g.hands[0].size(), 2, "125сброшена цена способности")
	athame.choose(0, "athame_discard", {"target": 1})
	athame.close()
	t.equal(athame.g.phase, "forced_discard", "125целевой игрок сам сбрасывает")
	for id in [126, 162]:
		var fixed = _game(t, id)
		fixed.g._push({"kind": "roll", "owner": 1, "value": 4}, "turn")
		fixed.ok(0, "activate", {"item": 1})
		fixed.close()
		fixed.choose(0, "set_roll12", {"face": 3 if id == 126 else 6})
		t.equal(int(fixed.g.stack.back().final_value), 3 if id == 126 else 6, "126/162устанавливают конечное значение")
	var wiz = _game(t, 127)
	_trigger(wiz, "combat_monster_damage", {"seat": 0, "card": 423, "amount": 1})
	t.check(not wiz.g._card_choices().any(func(c): return c.arg.get("op") == "monster_damage" and c.arg.get("item") == 0), "127не повторяет урон прежней цели")
	wiz.choose(0, "damage", {"target": 2})
	t.equal(wiz.g.hp[2], 1, "127повреждает выбранную другую цель")
	var eye = _game(t, 128)
	t.equal(eye.g.get_view(2).players[1].get("hand", []), eye.g.hands[1], "128открывает чужую руку")
	t.check(not eye.g.get_view(1).players[0].has("hand"), "128не открывает руку владельца")
	for face in [1, 6]:
		var krampus = _game(t, 129)
		_activate(krampus)
		krampus.roll(face)
		krampus.ok(0, "effect_roll")
		krampus.close()
		t.equal(krampus.g.hp, [1, 1, 1] if face == 1 else [2, 2, 2], "129ветка игроков")
		t.equal(int(krampus.g.monsters[0].hp), 8 if face == 1 else 7, "129ветка монстров")
	var keeper = _game(t, 130)
	_trigger(keeper, "monster_damage", {"seat": 0, "amount": 3, "card": 423})
	t.equal(keeper.g.coins[0], 9, "130монета за событие урона, не за единицу")
	_trigger(keeper, "death", {"seat": 1, "killer": 0})
	t.equal(keeper.g.coins[0], 11, "130две монеты за убийство игрока")
	var legs = _game(t, 131)
	_trigger(legs, "turn_start")
	legs.choose(0, "monster_damage", {"item": 1})
	t.equal(int(legs.g.monsters[1].hp), 7, "131в начале хода выбирается цель")
	var phd = _game(t, 132)
	phd.g._begin_resolving({"kind": "test_operation", "owner": 0, "card": -1})
	phd.roll(3)
	phd.ok(0, "effect_roll")
	phd.close()
	phd.choose(0, "phd_adjust", {"amount": 1})
	phd.close()
	t.equal(phd.g.last_roll, 4, "132меняет небоевой бросок до его пассивов")
	var divorce = _game(t, 133)
	_item(divorce, 1, 143)
	_activate(divorce)
	divorce.choose(0, "divorce_target", {"target": 1})
	t.equal(divorce.g._card_choice_owner(), 1, "133половину карт отдающий выбирает сам")
	t.check(divorce.g.get_view(0).card_choices.is_empty(), "133получатель не видит чужой выбор руки")
	divorce.choose(1, "divorce_hand", {"item": 2})
	divorce.choose(1, "divorce_item")
	t.equal(divorce.g.coins[0], 12, "133половина9монет округлена вниз")
	t.equal(divorce.g.hands[0].size(), 4, "133половина3карт округлена вниз")
	t.equal(divorce.g._item_count(0, 143), 1, "133выбранный предмет передан")
	var forget = _game(t, 134)
	forget._take(475)
	forget.g._gain_soul_card(1, {"id": 475, "value": 1})
	_activate(forget)
	forget.choose(1, "destroy_soul12")
	t.equal(forget.g.souls[1], 0, "134душу уничтожает её владелец")
	var bug = _game(t, 135)
	_item(bug, 1, 143)
	_trigger(bug, "roll", {"seat": 1, "value": 1})
	bug.choose(0, "reroll_item", {"target": 1})
	bug.close()
	t.equal(bug.g._item_count(1, 143), 0, "135перебрасывает предмет бросившего1")
	var candle = _game(t, 136)
	_activate(candle)
	candle.choose(0, "candle_face", {"face": 4})
	candle.g._destroy_item(0, 1)
	_trigger(candle, "roll", {"seat": 1, "value": 4})
	candle.choose(0, "damage", {"target": 2})
	t.equal(candle.g.hp[2], 1, "136действует до конца хода после потери источника")
	var magnet = _game(t, 137)
	_trigger(magnet, "coins", {"seat": 1, "amount": 2})
	t.equal(magnet.g.coins[0], 9, "137переводит1монету владельцу")
	t.equal(magnet.g.coins[1], 8, "137монета взята у получателя, не банка")
	var haunt = _game(t, 138)
	_trigger(haunt, "death", {"seat": 0, "killer": 1})
	haunt.choose(0, "haunt_give", {"target": 2})
	t.equal(haunt.g._item_count(2, 138), 1, "138передаётся до штрафа за смерть")
	var shadow = _game(t, 139)
	shadow.g.current = 1
	shadow.g.priority = 1
	shadow.ok(1, "attack", {"slot": 0})
	shadow.close()
	shadow.choose(0, "redirect_attack", {"item": 1})
	shadow.close()
	t.equal(shadow.g.battle, 1, "139меняет объявленную цель до начала боя")
	var multi = _game(t, 140)
	_activate(multi)
	multi.g._begin_resolving({"kind": "test_operation", "card": -1, "owner": 1})
	multi.roll(1, [2, 5, 4])
	multi.ok(1, "effect_roll")
	multi.close()
	for index in 3:
		t.equal(multi.g.actor(), 1, "140все четыре кубика бросает исходный игрок")
		multi.ok(1, "effect_roll")
		multi.close()
	t.equal(multi.g._card_choice_owner(), 0, "140результат выбирает контроллер")
	multi.choose(0, "multi_choose", {"index": 2})
	multi.close()
	t.equal(multi.g.last_roll, 5, "140выбран нужный результат")
	t.equal(multi.g._turn_faces, [5], "140числовые пассивы срабатывают один раз")
	var hourglass = _game(t, 141)
	_item(hourglass, 1, 143)
	_trigger(hourglass, "roll", {"seat": 2, "value": 2})
	hourglass.choose(0, "deactivate", {"target": 1, "item": 1})
	t.check(hourglass.g.items[1][1].tapped, "141поворачивает выбранный предмет")
	var life = _game(t, 142)
	life.g.hp[0] = 0
	life.g._check_deaths()
	life.close()
	t.equal(life.g.hp[0], life.g.max_hp[0], "142предотвращает смерть и полностью лечит")
	t.equal(life.g._item_count(0, 142), 0, "142уничтожена как цена спасения")
	t.check(not life.g.dead[0], "142штраф за смерть не оплачен")
	var poly = _game(t, 143)
	t.equal(poly.g.attack[0], 3, "143две атаки")
	t.equal(poly.g._monster_evasion(poly.g.monsters[0]), FSData.stat(423, "dc", 4) + 1, "143монстрам+1уклонение")
	var cursed = _game(t, 144)
	_trigger(cursed, "attack_roll", {"seat": 0, "value": 1})
	cursed.close()
	t.check(cursed.g.current != 0, "144единица завершает ход")
	for mode in ["loot", "coins", "damage"]:
		var rainbow = _game(t, 145)
		_activate(rainbow)
		rainbow.choose(0, "rainbow_mode", {"mode": mode})
		t.equal(rainbow.g.hp[2], 1 if mode == "damage" else 2, "145общий урон выбранной ветки")
		t.equal(rainbow.g.coins[2], 10 if mode == "coins" else 8, "145общие монеты выбранной ветки")
		t.equal(rainbow.g.hands[2].size(), 2 if mode == "loot" else 1, "145общий добор выбранной ветки")
	var cement = _game(t, 146)
	_trigger(cement, "attack_miss", {"seat": 0})
	cement.roll(3)
	cement.ok(0, "effect_roll")
	cement.close()
	cement.choose(0, "damage", {"target": 2})
	t.equal(cement.g.hp[2], 1, "146попадание после промаха на1–3")
	var lard = _game(t, 147)
	t.equal(lard.g.max_hp[0], 4, "147два здоровья")
	_trigger(lard, "damage", {"seat": 0})
	lard.choose(0, "discard_loot")
	t.equal(lard.g.hands[0].size(), 2, "147обязательный выбранный сброс при уроне")
	var admiration = _game(t, 148)
	_activate(admiration)
	admiration.choose(0, "admiration_target", {"target": 1})
	t.equal(admiration.g._card_choice_owner(), 1, "148отдающий сам выбирает лут")
	admiration.choose(1, "admiration_gift", {"item": 0})
	t.check(not admiration.g.get_view(2).peek.is_empty(), "148отданная карта открыта всем")
	admiration.choose(0, "close_peek")
	admiration.close()
	t.equal(admiration.g.free_loot, 1, "148принудительный розыгрыш бесплатен")
	t.check(482 in admiration.g.discards.loot, "148подарок действительно разыгран")
	var telepathy = _game(t, 149)
	_trigger(telepathy, "turn_start")
	telepathy.roll(4)
	telepathy.ok(0, "effect_roll")
	telepathy.close()
	telepathy.g._begin_resolving({"kind": "test_operation", "owner": 0, "card": -1})
	telepathy.roll(2)
	telepathy.ok(0, "effect_roll")
	telepathy.close()
	telepathy.choose(0, "telepathy_use")
	telepathy.close()
	t.equal(telepathy.g.last_roll, 4, "149следующий бросок заменён запомненным")
	t.check(not telepathy.g._telepathy_faces.has(0), "149замена только следующего броска")
	var fly = _game(t, 150)
	_activate(fly)
	fly.choose(0, "peek_deck", {"deck": "treasure"})
	var top: int = int(fly.g.peek.cards[0])
	fly.choose(0, "fly_top", {"mode": "discard"})
	t.check(top in fly.g.discards.treasure, "150выбранный верх сброшен")
	_trigger(fly, "damage", {"seat": 0})
	fly.choose(0, "fly_recharge")
	t.check(not fly.g.items[0][1].tapped, "150полученный урон перезаряжает по выбору")
	var black = _game(t, 151)
	for id in [728, 735]:
		black._take(id)
		black.g.decks.monster.append(id)
	_activate(black)
	black.choose(0, "candle_curse", {"card": 728})
	black.choose(0, "candle_assign", {"target": 2})
	black.choose(0, "skip_choice")
	while not black.g.peek.is_empty():
		black.choose(0, "candle_bottom")
	t.check(728 in black.g.curses[2], "151проклятие передано выбранному игроку")
	t.check(735 in black.g.decks.monster.slice(0, 5), "151остальные положены вниз")
	var euthanasia = _game(t, 152)
	euthanasia.g.battle = 0
	_trigger(euthanasia, "attack_roll", {"seat": 0, "value": 4})
	_trigger(euthanasia, "attack_roll", {"seat": 0, "value": 4})
	t.check(not euthanasia.g.monsters.any(func(m): return int(m.id) == 423 and int(m.hp) > 0), "152повтор результата убивает текущего монстра")
	var d10 = _game(t, 153)
	_trigger(d10, "roll", {"seat": 1, "value": 3})
	d10.choose(0, "key_cover", {"item": 1})
	d10.close()
	t.check(int(d10.g.monsters[1].id) != 427, "153накрывает выбранный неатакованный слот")
	for face in range(1, 7):
		var d100 = _game(t, 154)
		_activate(d100)
		d100.roll(face)
		d100.ok(0, "effect_roll")
		d100.close()
		t.equal(d100.g.hands[0].size(), 3 + (face if face <= 2 else 0), "154добор1/2")
		t.equal(d100.g.coins[0], 8 + (face if face in [3, 4] else 0), "154монеты3/4")
		t.equal(d100.g.max_hp[0], 3 if face == 5 else 2, "154здоровье до конца хода")
		t.equal(d100.g.attack[0], 2 if face == 6 else 1, "154атака до конца хода")
	var d20 = _game(t, 155)
	var old_shop: int = int(d20.g.shop[0])
	_activate(d20)
	d20.choose(0, "reroll_item", {"shop": true, "item": 0})
	t.check(int(d20.g.shop[0]) != old_shop and old_shop in d20.g.discards.treasure, "155перебрасывает магазин")
	var d4 = _game(t, 156)
	_item(d4, 1, 143)
	_item(d4, 1, 147)
	_activate(d4)
	d4.choose(0, "d4_inventory", {"target": 1})
	t.equal(d4.g.items[1].size(), 3, "156число предметов сохранено")
	t.check(143 in d4.g.discards.treasure and 147 in d4.g.discards.treasure, "156переброшены исходные предметы")
	var donation = _game(t, 157)
	_item(donation, 0, 143)
	donation.ok(0, "activate", {"item": 1})
	donation.choose(0, "donation_item", {"card": 143})
	donation.choose(0, "donation_give", {"target": 2})
	t.equal(donation.g._item_count(2, 143), 1, "157предмет отдан до окна ответов")
	donation.close()
	t.equal(donation.g.coins[0], 16, "157после цены получено8монет")
	var bumbo = _game(t, 158)
	var bank: int = bumbo.g.bank
	bumbo.g._gain_coins(0, 10)
	t.equal(bumbo.g.coins[0], 8, "158вместо монет уровни")
	t.equal(bumbo.g.bank, bank, "158уровни не тратят банк")
	t.equal(bumbo.g.items[0][1].counters, 10, "158получено10уровней")
	t.equal(bumbo.g.attack[0], 2, "158атака на10уровне")
	t.equal(preload("res://games/four_souls/logic/fs_passive_rules.gd").attack_modifiers(bumbo.g.items[0], 1).roll_bonus, 2, "158первая атака+2на1уровне")
	bumbo.g._gain_coins(0, 15)
	t.check(bumbo.g.attack_left >= 99, "158неограниченные атаки на25уровне")
	var battery = _game(t, 159)
	_item(battery, 1, 143)
	battery.g.items[1][1].tapped = true
	_activate(battery)
	t.check(not battery.g._card_choices().any(func(c): return c.arg.get("target") == 0 and c.arg.get("item") == 1), "159не перезаряжает себя")
	battery.choose(0, "recharge", {"target": 1, "item": 1})
	t.check(not battery.g.items[1][1].tapped, "159перезаряжает чужой предмет")
	var bum = _game(t, 160)
	_item(bum, 1, 143)
	bum.g.items[1][1].tapped = true
	_activate(bum)
	t.equal(bum.g.coins[0], 4, "160четыре монеты оплачены заранее")
	bum.choose(0, "recharge", {"target": 1, "item": 1})
	t.check(not bum.g.items[1][1].tapped, "160перезарядка чужого предмета")
	var eden = _game(t, 161)
	eden.g.bank += int(eden.g.coins[0])
	eden.g.coins[0] = 0
	_trigger(eden, "turn_end")
	t.equal(eden.g.coins[0], 6, "161на конце хода при0монет получает6")
	var boomerang = _game(t, 163)
	_activate(boomerang)
	boomerang.choose(0, "boomerang_take", {"target": 1})
	t.equal(boomerang.g.hands[0].size(), 4, "163украдена одна случайная карта")
	t.equal(boomerang.g.hands[1].size(), 2, "163карта ушла из руки цели")

	# Общие границы новых механизмов, без повторения полной партии.
	var tap_guard = _game(t, 163)
	tap_guard.g.items[0][1].tapped = true
	tap_guard.no(0, "activate", {"item": 1, "tap": false}, "Нельзя подделать оплату поворотом")
	var unpaid = _game(t, 160)
	unpaid.g.bank += int(unpaid.g.coins[0]) - 3
	unpaid.g.coins[0] = 3
	unpaid.no(0, "activate", {"item": 1}, "160недостаточная цена")
	var guard = _game(t, 148)
	guard._take(814)
	guard.g.room = 814
	guard.g._room_loot_plays[0] = 1
	_activate(guard)
	guard.choose(0, "admiration_target", {"target": 1})
	guard.choose(1, "admiration_gift", {"item": 0})
	guard.choose(0, "close_peek")
	guard.close()
	t.check(482 in guard.g.hands[0], "148сохраняет подарок, когда814запрещает розыгрыш")
	var p_attack = _game(t, 132)
	p_attack.ok(0, "attack", {"slot": 0})
	p_attack.close()
	p_attack.roll(5)
	p_attack.ok(0, "roll")
	p_attack.close()
	t.check(int(p_attack.g.resolving.get("card", -1)) != 132, "132не изменяет бросок атаки")
	var four_attack = _game(t, 140)
	_item(four_attack, 0, 24)
	_activate(four_attack)
	four_attack.ok(0, "attack", {"slot": 0})
	four_attack.close()
	four_attack.roll(1, [2, 3, 4])
	four_attack.ok(0, "roll")
	four_attack.close()
	for index in 3:
		four_attack.ok(0, "effect_roll")
		four_attack.close()
	four_attack.choose(0, "multi_choose", {"index": 3})
	four_attack.close()
	t.equal(int(four_attack.g._turn_attack_rolls.get(0, 0)), 1, "140четыре кубика считаются одной атакой")
	t.equal(four_attack.g._turn_faces, [5], "140бонус24применён один раз к выбранному результату")
	var no_life = _game(t, 142)
	no_life.g.current = 1
	no_life.g.hp[0] = 0
	no_life.g._check_deaths()
	no_life.close()
	t.equal(no_life.g._item_count(0, 142), 1, "142не спасает вне своего хода")
	var bumbo_room = _game(t, 158)
	bumbo_room._take(807)
	bumbo_room.g.room = 807
	bumbo_room.g._gain_coins(1, 3)
	t.equal(bumbo_room.g.items[0][1].counters, 3, "158заменяет свою долю Равенства уровнями")
	t.equal(bumbo_room.g.coins[1], 12, "807другая доля остаётся монетами")
