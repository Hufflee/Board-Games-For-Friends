extends "res://tests/fs/core/core_automation_batch18.gd"
## Общие границы18: раскрытый противник, владелец урона и обязательный бросок активного.
func run(t: Check) -> void:
	var team = _monster(t, 340)
	team._take(339)
	team.g.decks.monster.append(339)
	team.ok(0, "attack", {"slot": -1, "over": 1})
	team.close()
	_die(team, 6)
	team.close()
	team.close()
	t.equal(int(team.g._team_source15.get("id", -1)), 339, "339 раскрытие колоды запускает собственную командную атаку")
	t.equal(team.g.roll_no, 1, "340 глобальное объявление не повторяется после раскрытия")
	team.roll(6)
	team.ok(0, "roll")
	team.close()
	t.equal(team.g.actor(), 1, "339 напарник бросает и при атаке из колоды")
	var hand = _monster(t, 373)
	hand._take(396)
	hand.g.decks.monster.append(396)
	hand.ok(0, "attack", {"slot": -1, "over": 1})
	hand.close()
	hand.choose(0, "discard_target18", {"target": 1})
	hand.choose(1, "discard_victim_card16", {"target": 1, "item": 0})
	hand.choose(1, "discard_victim_card16", {"target": 1, "item": 0})
	t.equal(hand.g.phase, "battle_roll", "396 после двух сбросов не появляется повторная ручная фаза")
	var familiar = _monster(t, 275)
	familiar._take(293)
	familiar.g._gain_soul_card(0, {"id": 293, "value": 1})
	familiar.g.battle = 0
	familiar.g.phase = "battle_roll"
	_trigger(familiar, "damage", {"seat": 0, "amount": 1})
	t.equal(int(familiar.g.monsters[1].hp), 7, "275 урон от монстра не считается уроном игрока с душой293")
	t.check(not familiar.g._card_automation_active(), "275 не требует лишнего броска души атакующего")
	var player_damage = _monster(t, 387)
	player_damage._take(293)
	player_damage.g._gain_soul_card(0, {"id": 293, "value": 1})
	_trigger(player_damage, "monster_death", {"seat": 0, "card": 387})
	player_damage.choose(0, "player_damage18", {"target": 1})
	_die(player_damage, 1)
	player_damage.close()
	t.equal(player_damage.g.hp[1], 2, "387 урон именно активного игрока предотвращается его душой293")
	var heart = _monster(t, 373)
	heart._take(381)
	heart.g._gain_soul_card(0, {"id": 381, "value": 2}, false)
	t.equal(heart.g.winner, -1, "381 победа от переноса души разрешается через стек")
	heart.close()
	t.equal(heart.g.winner, 0, "381 перенос вне награды тоже вызывает победу лидера")
	var fly = _monster(t, 392)
	fly.operation_panel(1)
	fly.effect(1, "monster_damage", {"item": 0, "amount": 1})
	t.equal(fly.g.actor(), 0, "392 бросает активный, а не наносивший урон игрок")
	_die(fly, 1)
	fly.ok(1, "effect_done")
	fly.close()
	t.equal(int(fly.g.monsters[0].hp), 4, "392 чужой урон предотвращён активным")
