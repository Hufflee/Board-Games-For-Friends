extends "res://tests/fs/core/core_automation_batch19.gd"
## Общие границы пакета21: оплата, чужие выборы и физическая карта под предметом.
func _play21(s: RefCounted, id: int, seat: int = 0) -> void:
	s._take(id)
	s.g.hands[seat].append(id)
	s.ok(seat, "loot", {"card": id})
	s.close()

func run(t: Check) -> void:
	var catalog := preload("res://games/four_souls/logic/fs_packet21_cards.gd")
	t.equal(catalog.ALL_IDS.size(), 40, "Группа21 содержит сорок полных текстов")
	var bill = _game(t, 37)
	_attack_roll17(bill, 6)
	t.equal(int(bill.g.monsters[0].hp), 8, "37 ждёт отдельный бросок перед нанесением урона")
	_die(bill, 6)
	bill.close()
	t.equal(int(bill.g.monsters[0].hp), 6, "37 шестёрка прибавила ровно один урон")
	var battery = _game(t, 44)
	battery.g.items[1][0].tapped = true
	_activate(battery)
	battery.choose(0, "battery_item21", {"target": 1, "item": 0})
	t.check(not bool(battery.g.items[1][0].tapped), "44 перезаряжает выбранный чужой предмет")
	battery.ok(0, "activate", {"item": 1, "ability": "paid"})
	battery.close()
	t.equal(battery.g.coins[0], 1, "44 собственная перезарядка стоит7¢")
	t.check(not bool(battery.g.items[0][1].tapped), "44 платная способность доступна повёрнутому источнику")
	var auction = _game(t, 46)
	var offered: int = int(auction.g.shop[0])
	_activate(auction)
	auction.choose(0, "auction_prepare21", {"item": 0})
	auction.choose(1, "auction_bid21", {"amount": 2})
	auction.choose(2, "auction_bid21", {"amount": 3})
	auction.choose(1, "auction_bid21", {"amount": 0})
	t.equal(auction.g.coins, [11, 9, 5], "46 платит только победитель и только аукционисту")
	t.check(auction.g.items[2].any(func(item): return int(item.id) == offered), "46 выбранная физическая карта досталась победителю")
	var treasure = _game(t, 52)
	treasure.operation_panel()
	treasure.effect(0, "treasure", {"target": 0, "amount": 1})
	t.equal(treasure.g.items[0].size(), 4, "52 одна выдача сокровищ увеличена на1")
	var gift = _game(t, 53)
	_activate(gift)
	var kept: int = int(gift.g.peek.cards[0])
	t.check(gift.g.get_view(1).peek.is_empty(), "53 частный просмотр не раскрыт сопернику")
	gift.choose(0, "loot_three21", {"card": kept})
	gift.choose(0, "loot_rest21", {"target": 1})
	t.check(kept in gift.g.hands[0], "53 выбранная карта у владельца")
	t.equal(gift.g.hands[1].size(), 5, "53 две оставшиеся карты отданы одному сопернику")
	var held = _game(t, 54)
	_activate(held)
	held.choose(0, "hold_monster21", {"item": 0})
	t.equal(int(held.g.items[0][1].held_monster21), 423, "54 под предметом хранится физический монстр")
	held.g.items[0][1].tapped = false
	_activate(held)
	held.choose(0, "release_monster21", {"item": 0})
	t.check(423 in held.g._forced_monsters14, "54 возвращённого монстра надо атаковать")
	var swap = _game(t, 83)
	swap.g._character_tokens20[0] = 1
	swap.g._refresh_passive_stats()
	_activate(swap)
	swap.choose(0, "replace_character21", {"card": 823})
	t.equal(swap.g.chars[0], 823, "83 выбран новый персонаж вне игры")
	t.equal(int(swap.g.items[0][0].id), 824, "83 заменён стартовый предмет")
	t.check(not swap.g._character_tokens20.has(0), "83 жетон оставлен у прежней карты персонажа")
	var soul = _game(t, 71)
	_play21(soul, 475)
	t.equal(soul.g.items[0].size(), 4, "475 вход в игру даёт два сокровища")
	soul.choose(0, "gift_soul21", {"target": 1})
	t.equal(soul.zone_of(475), "soul:1", "475 физическая карта стала душой другого игрока")
	var ward = _game(t, 71)
	_item(ward, 1, 72)
	_play21(ward, 531)
	ward.choose(0, "black_heart", {"target": 1})
	ward.close()
	t.equal(ward.g.actor(), 1, "72 решение об отмене принадлежит цели")
	ward.choose(1, "cancel_target21")
	ward.close()
	t.check(531 in ward.g.discards.loot, "72 отменённая карта сброшена один раз")
	var guard = _game(t, 71)
	guard._take(470)
	guard.g.hands[1].append(470)
	_play21(guard, 531)
	guard.choose(0, "black_heart", {"target": 1})
	guard.ok(1, "loot", {"card": 470})
	guard.close()
	guard.choose(1, "cancel_target21")
	guard.close()
	t.equal(guard.g.hp[0], 0, "470 после отмены наносит2урона источнику")
