extends "res://tests/fs/core/core_automation_batch25.gd"
## Стартовые предметы группы 26 через активации, стоимость и события.
func run(t: Check) -> void:
	var nickel = _game(t, 845)
	_activate(nickel)
	nickel.choose(0, "nickel_target26", {"target": 2})
	_die(nickel, 6)
	t.equal(nickel.g.coins, [8, 9, 14], "845 выдаёт выбранному игроку ровно выпавшее число монет")
	var craft = _game(t, 869)
	craft.no(0, "activate", {"item": 1, "ability": "craft_get26"})
	craft.ok(0, "activate", {"item": 1, "ability": "craft_store26"})
	craft.choose(0, "loot_cost26", {"item": 0})
	t.check(549 in craft.g.discards.loot, "869 оплачена физическая карта")
	craft.close()
	t.equal(int(craft.g.items[0][1].counters), 1, "869 после оплаты получил жетон")
	craft.g.items[0][1].counters = 4
	craft.ok(0, "activate", {"item": 1, "ability": "craft_get26"})
	craft.close()
	t.equal(int(craft.g.items[0][1].counters), 0, "869 списаны четыре жетона")
	t.equal(craft.g.items[0].size(), 3, "869 выдаёт физическое сокровище")
	var trash = _game(t, 853)
	var before_trash: int = trash.g.hands[0].size()
	trash.ok(0, "activate", {"item": 1, "ability": "trash_draw26"})
	trash.close()
	t.equal(trash.g.coins[0], 4, "853 стоимость списана до применения")
	t.equal(trash.g.hands[0].size(), before_trash + 1, "853 за4¢ добирается одна карта")
	var gimpy = _game(t, 855)
	gimpy.no(0, "activate", {"item": 1})
	gimpy.g._damage_player(0, 1)
	gimpy.close()
	gimpy.choose(0, "gimpy26", {"mode": "attack"})
	t.equal(gimpy.g.attack[0], 3, "855 от полученного урона даёт выбранный бонус атаки")
	gimpy.ok(0, "end")
	gimpy.close()
	t.equal(gimpy.g.attack[0], 1, "855 бонус атаки действует до конца хода")
	var mantle = _game(t, 849)
	_activate(mantle)
	mantle.choose(0, "holy_save26", {"target": 1})
	mantle.g._damage_player(1, 3)
	mantle.g._check_deaths()
	mantle.close()
	t.equal(mantle.g.hp[1], 1, "849 предотвращает следующую смерть выбранного")
	t.equal(mantle.g.current, 0, "849 не завершает ход другого активного игрока")
	var eggs = _game(t, 859)
	_activate(eggs)
	eggs.choose(0, "pink_egg26", {"zone": "monster", "target": 0, "remove": false})
	var monster_id: int = int(eggs.g.monsters[0].id)
	t.equal(eggs.g._egg_count("monster", monster_id), 1, "859 кладёт яйцо на выбранного монстра")
	eggs.g._place_egg("player", 2, "red")
	var before_eggs: Array = eggs.g.hands.map(func(hand): return hand.size())
	eggs.g._egg_death("monster", monster_id, 0)
	eggs.close()
	t.equal(eggs.g.hands.map(func(hand): return hand.size()), [before_eggs[0] + 1, before_eggs[1] + 1, before_eggs[2]], "859 добычу получают только игроки без яиц")
	var capricious = _game(t, 71)
	capricious.g.chars[0] = 882
	var shop_card: int = int(capricious.g.shop[0])
	capricious.ok(0, "character")
	capricious.close()
	capricious.choose(0, "capricious26", {"mode": "shop"})
	capricious.choose(0, "discard_shop", {"item": 0})
	t.check(shop_card in capricious.g.discards.treasure, "882 сбрасывает выбранный предмет вместо дополнительного розыгрыша")
	t.equal(capricious.g._bonus_loot_plays[0], 0, "882 применяет одну ветку")
	var flip = _game(t, 881)
	flip.g.chars[0] = 880
	_trigger(flip, "after_death", {"seat": 0})
	t.equal(flip.g.max_hp[0], 1, "881 переворачивает Энигму на сторону с одним здоровьем")
	t.equal(flip.g.attack[0], 2, "881 перевёрнутая сторона имеет две атаки")
	t.check(bool(flip.g.get_view(1).players[0].get("enigma_back26", false)), "881 сторона публична")
	_trigger(flip, "after_death", {"seat": 0})
	t.equal(flip.g.max_hp[0], 2, "881 второй переворот возвращает характеристики")
	var lost = _game(t, 71)
	lost.g.chars[0] = 848
	lost.g._refresh_passive_stats()
	t.equal(lost.g.souls[0], 1, "848 персонаж сам приносит одну душу")
	lost.g.character_ready[2] = false
	_trigger(lost, "turn_end")
	lost.choose(0, "ready_character", {"target": 2})
	t.check(lost.g.character_ready[2], "848 в конце своего хода может перезарядить чужого персонажа")
