extends RefCounted
## Всадник264 (Summer of Isaac): замещение смерти, реальный источник урона и истечение бонусов.
## Изображение264.webp и https://foursouls.com/cards/soi-headless_horseman/ сверены02.11.
const Scenario := preload("res://tests/fs/fs_scenario.gd")
const Check := preload("res://tests/fs/fs_check.gd")

func _game(t: Check, health: int = 1):
	return Scenario.new(t).players(2).dlc().current(0).character(0, 821).no_items(0).no_items(1) \
		.monster(0, 264, {"hp": health}).monster(1, 344).deck_top("treasure", [91]).hand(0, [497]).build()

func run(t: Check) -> void:
	var s = _game(t)
	s.roll(4)
	s.ok(0, "attack", {"slot": 0})
	s.ok(0, "roll", null)
	s.close()
	t.equal(s.g.phase, "battle_roll", "Бой продолжается после предотвращения смерти")
	t.equal(s.g.monsters[0].hp, 2, "Восстановлено всё напечатанное здоровье")
	t.equal(s.g.monsters[0].dc, 4, "+1 защиты после спасения")
	t.equal(s.g.monsters[0].at, 2, "+1 атаки после спасения")
	t.equal(s.g.souls[0], 0, "Живой Всадник не создаёт душу")
	t.equal(s.zone_of(264), "monster:0", "Физическая карта осталась на столе")
	t.check(s.g.items[0].any(func(item): return item.id == 91), "Активный игрок получил сокровище через стек")
	t.equal(s.g.bonus_progress.monsters, 0, "Предотвращённая смерть не считается убийством")
	t.equal(s.g._turn_kills, 0, "Первое убийство не расходуется спасением")
	s.inv("Замещение смерти на четвёрке")
	# Усиление складывается, а весь накопленный бонус снимается в конце хода.
	s.roll(4, [4])
	s.ok(0, "roll", null)
	s.close()
	s.ok(0, "roll", null)
	s.close()
	t.equal(s.g.monsters[0].dc, 5, "Повторное спасение складывает защиту")
	t.equal(s.g.monsters[0].at, 3, "Повторное спасение складывает атаку")
	s.operation_panel() # Проверяется истечение модификаторов, не способность Бомбы отменять бой.
	s.effect(0, "cancel_attack")
	s.ok(0, "effect_done", null)
	s.close()
	s.ok(0, "end", null)
	s.close()
	t.equal(s.g.monsters[0].dc, 3, "Вся временная защита снята")
	t.equal(s.g.monsters[0].at, 1, "Вся временная атака снята")
	var six = _game(t)
	six.roll(6)
	six.ok(0, "attack", {"slot": 0})
	six.ok(0, "roll", null)
	six.close()
	t.check(six.g.resolving.is_empty(), "Смертельная шестёрка выдала награду без ручной панели")
	t.check(six.g.items[0].any(func(item): return item.id == 91), "Сокровище настоящей смерти выдано автоматически")
	t.equal(six.zone_of(264), "soul:0", "После настоящей смерти карта стала душой")
	t.equal(six.g.souls[0], 1, "Душа начислена только при настоящей смерти")
	# Ранее выпавшая6 не превращает последующую бомбу в смертельный бросок6.
	var bomb = _game(t, 2)
	bomb.roll(6)
	bomb.ok(0, "attack", {"slot": 0})
	bomb.ok(0, "roll", null)
	bomb.close()
	bomb.ok(0, "loot", {"card": 497})
	bomb.close()
	bomb.choose(0, "monster_damage", {"item": 0})
	bomb.close()
	t.equal(bomb.g.monsters[0].hp, 2, "Небоевой смертельный урон предотвращён после прежней6")
	t.equal(bomb.g.souls[0], 0, "Бомба не выдаёт душу Всадника")
	bomb.inv("Небоевой урон после шестёрки")
