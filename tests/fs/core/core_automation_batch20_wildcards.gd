extends "res://tests/fs/core/core_automation_batch19.gd"
## Засада и предмет-комната: копия текста сохраняет единственную физическую карту.
func _room20(s: RefCounted, owner: int = 0, index: int = 1) -> void:
	s._take(468)
	s.g._begin_resolving({"kind": "loot", "card": 468, "owner": 0, "_resume": "turn"})
	s.g._advance_card_automation()
	s.choose(0, "make_room20", {"target": owner, "item": index})

func run(t: Check) -> void:
	var spoon = _game(t, 143)
	var bonus: int = int(spoon.g.attack[0])
	_room20(spoon)
	t.equal(spoon.g.items[0].size(), 1, "468 карта ушла из предметов")
	t.equal(spoon.g._extra_rooms20.size(), 1, "468 расширила число комнат")
	t.equal(spoon.g.attack[0], bonus, "468 пассивная атака принадлежит активному")
	t.check(not spoon.g._extra_rooms20[0].has("owner"), "468 у комнаты нет владельца")
	spoon.g.current = 1
	spoon.g._refresh_passive_stats()
	t.equal(spoon.g.attack[0], 1, "468 бывший владелец потерял бонус комнаты")
	t.equal(spoon.g.attack[1], bonus, "468 следующий активный получил пассивный бонус")
	t.equal(spoon.g._item_count(0, 143), 0, "468 комната не даёт способность неактивному")
	t.equal(spoon.g._item_count(1, 143), 1, "468 активный использует текст комнаты")
	var glitter = _game(t, 19)
	_room20(glitter)
	glitter.close()
	glitter.no(1, "room_activate20", {"item": 0}, "468 чужой ход не даёт активировать комнату")
	glitter.ok(0, "room_activate20", {"item": 0})
	glitter.close()
	t.equal(int(glitter.g._top_loot20[0]), glitter.g.turn_serial, "468 действительная способность комнаты сработала")
	t.check(bool(glitter.g._extra_rooms20[0].tapped), "468 комната повернулась без перемещения в предметы")
	var destroy = _game(t, 38)
	_room20(destroy)
	destroy.close()
	destroy._take(769)
	destroy.g.decks.room.append(769)
	var coins_before: int = int(destroy.g.coins[0])
	destroy.ok(0, "room_activate20", {"item": 0})
	destroy.close()
	t.equal(destroy.g.coins[0], coins_before + 25, "468 самоуничтожение комнаты оплачивает её эффект")
	t.equal(int(destroy.g._extra_rooms20[0].id), 769, "468 пустое место пополнилось комнатой")
	t.check(destroy.g._room_has20(769), "468 напечатанное правило новой комнаты включено")
	t.equal(destroy.g.max_hp, [3, 3, 3], "468 новая обычная комната даёт всем+1HP")
	var ambush = _monster(t, 467)
	ambush._take(457)
	ambush.g.decks.monster.append(457)
	ambush.g.battle = 0
	_trigger(ambush, "attack_start", {"seat": 0, "slot": 0})
	t.equal(int(ambush.g.monsters[0].id), 457, "467 копирует верхний текст монстра")
	t.equal(int(ambush.g.monsters[0].physical_id20), 467, "467 физическая карта остаётся исходной")
	t.equal(int(ambush.g.decks.monster.back()), 457, "467 оригинал остаётся наверху колоды")
	ambush.g.monsters[0].hp = 0
	ambush.g.monsters[0]["slayer"] = 0
	ambush.g._continue_stack()
	ambush.close()
	if ambush.g.phase == "effect":
		ambush.ok(0, "effect_done")
		ambush.close()
	t.check(467 in ambush.g.hands[0], "467 возвращается в руку активного после смерти")
	t.equal(ambush.g.souls[0], 0, "467 не становится скопированной душой")
	t.check(467 not in ambush.g.discards.monster, "467 не загрязняет сброс монстров физическим лутом")
	var event_copy = _monster(t, 467)
	event_copy._take(699)
	event_copy.g.decks.monster.append(699)
	event_copy.g.battle = 0
	_trigger(event_copy, "attack_start", {"seat": 0, "slot": 0})
	t.equal(event_copy.g.battle, -1, "467 копирование неатакуемого события завершает атаку")
	t.check(event_copy.g._untargetable(699), "467 событие не атакуется как монстр")
