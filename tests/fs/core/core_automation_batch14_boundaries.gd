extends "res://tests/fs/core/core_automation_batch14.gd"
## Границы общих изменений: идентичность источника и виртуальные карты на стеке.
func run(t: Check) -> void:
	var copy = _game(t, 218)
	copy._take(202)
	copy.g.discards.treasure.append(int(copy.g.shop[0]))
	copy.g.shop[0] = 202
	_activate(copy)
	copy.choose(0, "permanent_copy14", {"card": 202, "shop": true})
	t.equal(int(copy.g.items[0][1].counters), 0, "218 счётчики оригинала не копируются")
	t.check(bool(copy.g.items[0][1].tapped), "218 состояние поворота сохраняется")
	copy.inv("218 копия предмета магазина")
	var passive = _game(t, 169)
	passive._take(143)
	passive.g.discards.treasure.append(int(passive.g.shop[0]))
	passive.g.shop[0] = 143
	_activate(passive)
	passive.choose(0, "copy_passive13", {"card": 143, "shop": true})
	t.equal(passive.g.attack[0], 3, "169 может копировать пассив магазина")
	var selfcopy = _game(t, 220)
	_item(selfcopy, 1, 199)
	_activate(selfcopy)
	selfcopy.choose(0, "copy_ability14", {"card": 199, "shop": false})
	t.check(220 in selfcopy.g.discards.treasure, "220 уничтожить себя означает уничтожить копирующий предмет")
	t.equal(selfcopy.g._item_count(1, 199), 1, "220 оригинал скопированной способности сохранён")
	var loot = _game(t, 227)
	loot._take(531)
	loot.g.hands[0].append(531)
	_activate(loot)
	loot.ok(0, "loot", {"card": 531})
	loot.close()
	loot.choose(0, "black_heart", {"target": 1})
	loot.close()
	loot.choose(0, "black_heart", {"target": 2})
	t.equal(int(loot.g.damage_shields[1]), 1, "227 первая копия выбрала свою цель")
	t.equal(int(loot.g.damage_shields[2]), 1, "227 вторая копия выбрала другую цель")
	t.equal(loot.g.discards.loot.count(531), 1, "227 один физический чёрный сердечко")
	loot.inv("227 разные цели")
	var soul = _game(t, 227)
	soul._take(475)
	soul.g.hands[0].append(475)
	_activate(soul)
	soul.ok(0, "loot", {"card": 475})
	soul.close()
	t.equal(soul.g.souls[0], 1, "227 виртуальная копия не создаёт физическую душу")
	soul.inv("227 потерянная душа существует одна")
	var sun = _game(t, 227)
	sun._take(636)
	sun.g.hands[0].append(636)
	_activate(sun)
	sun.ok(0, "loot", {"card": 636})
	sun.close()
	sun.close()
	t.equal(sun.g.decks.loot.count(636), 1, "227 Солнце под колодой существует одно")
	sun.inv("227 скопированное Солнце")
	var cannon = _game(t, 241)
	_item(cannon, 1, 143)
	_activate(cannon)
	cannon.choose(0, "glass_destroy14", {"card": 143})
	_die(cannon, 6)
	t.check(not bool(cannon.g.items[0][1].tapped), "241 на6 перезаряжается тот же физический источник после паузы")
	var eternal = _game(t, 241)
	eternal.g.items[0][1].eternal = true
	_item(eternal, 1, 143)
	_activate(eternal)
	eternal.choose(0, "glass_destroy14", {"card": 143})
	_die(eternal, 1)
	t.equal(eternal.g.hands[0].size(), 3, "241 вечная пушка не уничтожается и не даёт добычу")
	var changed = _game(t, 232)
	_item(changed, 0, 207)
	changed.g.battle = 0
	changed.g._push({"kind": "roll", "owner": 0, "value": 1}, "battle_roll")
	changed.close()
	t.equal(changed.g.last_roll, 2, "232 проверяет конечную1 после постоянных модификаторов")
	t.check(changed.g.resolving.is_empty(), "232 при конечной2 не предлагает замену")
	var flush = _game(t, 238)
	flush.g.battle = 0
	var active: int = int(flush.g.monsters[0].id)
	var other: int = int(flush.g.monsters[1].id)
	_activate(flush)
	flush.choose(0, "flush_mode14", {"mode": "monster"})
	t.equal(int(flush.g.monsters[0].id), active, "238 атакуемый монстр сохраняется")
	t.check(other in flush.g.decks.monster, "238 другой монстр под колодой")
	flush.inv("238 физические карты сохранены")
	var absent = _game(t, 239)
	absent.g.attack_left = 0
	absent.g.attacked = true
	_activate(absent)
	absent.choose(0, "force_monster14", {"item": 1})
	t.check(not absent.g._encounter_must_attack(), "239 не выдаёт дополнительную атаку")
	var first = _game(t, 209)
	_item(first, 1, 192)
	first.g.items[1][1].tapped = true
	_trigger(first, "damage", {"seat": 0, "amount": 1})
	first.choose(0, "skip_choice")
	_trigger(first, "damage", {"seat": 0, "amount": 1})
	t.check(first.g.resolving.is_empty(), "209 отказ первого урона не переносит способность на второй")

	var skipped = _game(t, 212)
	_item(skipped, 1, 143)
	_trigger(skipped, "roll", {"seat": 1, "value": 2})
	skipped.choose(0, "skip_choice")
	t.check(skipped.g.resolving.is_empty(), "212 отказ от обмена не вызывает выбор чужого предмета")
	var chaos = _game(t, 181)
	var shop_id: int = int(chaos.g.shop[0])
	_activate(chaos)
	chaos.choose(0, "chaos_mode13", {"mode": "destroy"})
	chaos.choose(0, "discard_shop", {"item": 0})
	t.check(shop_id in chaos.g.discards.treasure, "181 предмет магазина тоже допустим для уничтожения")
