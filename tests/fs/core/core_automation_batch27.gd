extends "res://tests/fs/core/core_automation_batch26.gd"
## Последние стартовые предметы, выбор чужого игрока и общие цели атаки.
func run(t: Check) -> void:
	var bargain = _game(t, 889)
	_activate(bargain)
	t.equal(bargain.g.actor(), 1, "889 первым отвечает следующий игрок")
	bargain.choose(1, "bargain_answer27", {"mode": "accept"})
	bargain.choose(2, "bargain_answer27", {"mode": "decline"})
	t.equal(bargain.g.coins, [10, 10, 8], "889 согласие выдаёт монету обеим сторонам")
	t.equal(bargain.g._purchase_cost(0, 0), 7, "889 скидка3 на предмет магазина")
	var lemegeton = _game(t, 895)
	_activate(lemegeton)
	t.equal(lemegeton.g.items[0].size(), 3, "895 сокровище появляется сразу")
	lemegeton.ok(0, "end")
	lemegeton.close()
	lemegeton.choose(0, "destroy", {"item": 2})
	lemegeton.close()
	t.equal(lemegeton.g.items[0].size(), 2, "895 предмет уничтожается в конце хода")
	var revenant = _game(t, 897)
	var before_revenant: int = revenant.g.hands[0].size()
	_activate(revenant)
	t.check(bool(revenant.g.items[0][1].revenant27), "897 переворачивает ту же карту на сторону Ревенанта")
	revenant.ok(0, "attack_familiar15", {"index": 0})
	revenant.close()
	revenant.g.attack[0] = 2
	revenant.roll(6)
	revenant.ok(0, "roll")
	revenant.close()
	t.check(not bool(revenant.g.items[0][1].get("revenant27", false)), "897 после поражения возвращается лицом вверх")
	t.equal(revenant.g.hands[0].size(), before_revenant + 3, "897 две добычи атакующему, одна при перевороте")
	t.equal(revenant.g.attack_left, 1, "897 атакующему возвращается возможность атаки")
	var tar = _game(t, 901)
	tar._take(549)
	tar.g._push({"kind": "loot", "card": 549, "owner": 1}, "turn")
	var face_value: int = FSData.coin_loot_value(549)
	tar.ok(0, "activate", {"item": 1, "ability": "tar_paid27"})
	tar.choose(0, "loot_cost26", {"item": 0})
	tar.close()
	tar.choose(0, "tar_mode27", {"mode": "copy"})
	tar.choose(0, "tar_copy27", {"index": 0})
	tar.close()
	t.equal(tar.g.coins, [8 + face_value, 9 + face_value, 8], "901 копия выдаёт отдельный эффект владельцу")
	t.equal(tar.g.discards.loot.count(549), 1, "901 копия не создаёт вторую физическую карту")
	var bag = _game(t, 912)
	var old: Array = bag.g.hands[0].duplicate()
	bag.g._complete_turn_start()
	t.equal(bag.g.hands[0].size(), 2, "912 сбрасывает руку до обычного добора и добавляет одну карту")
	t.check(old.all(func(id): return id in bag.g.discards.loot), "912 прежняя рука в сбросе")
	var squid = _game(t, 910)
	var base_health: int = int(squid.g.monsters[0].hp)
	squid.ok(0, "attack", {"slot": 0})
	squid.close()
	squid.choose(0, "squid_buff27", {"mode": "accept"})
	t.equal(squid.g.monsters[0].hp, base_health + 1, "910 даёт атакованному монстру дополнительное здоровье")
	squid.choose(0, "squid_invite27", {"target": 1})
	squid.choose(1, "squid_join27", {"mode": "accept"})
	t.equal(squid.g._coop_partners20, [1], "910 напарник сам соглашается")
	squid.g.monsters[0].hp = 1
	squid.roll(6)
	squid.ok(0, "roll")
	squid.close()
	squid.choose(0, "squid_token27", {"item": 1})
	t.equal(int(squid.g.items[0][1].health_tokens15), 1, "910 жетон получает предмет игрока, бросавшего против монстра")
	var counter = _game(t, 68)
	var id: int = int(counter.g.monsters[0].id)
	counter.g._place_egg("monster", id, "black")
	_activate(counter)
	counter.choose(0, "typed_counter21", {"zone": "monster_egg", "field": "black", "amount": 1})
	t.equal(counter.g._egg_count("monster", id), 2, "68 добавляет жетон нужного типа")
	var view = _game(t, 71)
	_room24(view, 767)
	view.g.required_player_attacks = 1
	view.ok(0, "attack_player", {"target": 1})
	view.choose(0, "skip_choice")
	view.choose(0, "room_attack_choice24", {"kind24": "attack_player", "attack24": {"target": 1}})
	view.close()
	t.equal(view.g.battle_player, 1, "767 предлагает атаку игрока после окна просмотра")
