extends "res://tests/fs/core/core_automation_batch19.gd"
## Первая часть40-карточного пакета20; отдельно до окончания всей группы не запускать.
func run(t: Check) -> void:
	var leaper = _monster(t, 452)
	leaper.g.max_hp[0] = 6
	leaper.g.hp[0] = 6
	_attack_roll17(leaper, 1)
	t.equal(leaper.g.hp[0], 4, "452 единица удваивает урон ровно один раз")
	var scolex = _monster(t, 453)
	_trigger(scolex, "damage", {"seat": 1, "monster": 453, "amount": 1})
	t.equal(scolex.g._card_choice_owner(), 1, "453 свою карту сбрасывает получивший урон")
	scolex.choose(1, "discard_victim_card16", {"item": 0})
	t.equal(scolex.g.hands[1].size(), 1, "453 одна выбранная карта сброшена")
	var death = _monster(t, 454)
	_trigger(death, "monster_death", {"seat": 0, "card": 454})
	death.choose(0, "kill_player16", {"target": 2})
	t.equal(death.g.hp[2], 0, "454 выбранный игрок убит")
	var globin = _monster(t, 455)
	_trigger(globin, "monster_death", {"seat": 0, "card": 455})
	globin.choose(0, "discard_target18", {"target": 1})
	globin.choose(1, "discard_victim_card16", {"item": 0})
	globin.choose(1, "discard_victim_card16", {"item": 0})
	t.equal(globin.g.hands[1].size(), 0, "455 чужой владелец выбрал обе сброшенные карты")
	var dark = _monster(t, 456)
	_trigger(dark, "monster_damage", {"seat": 0, "card": 456, "amount": 1})
	t.equal(int(dark.g.monsters[0].at), 2, "456 повреждение даёт+1атаки")
	for id in [457, 458]:
		var plain = _monster(t, id)
		t.equal(plain.g._printed_monster_reward(id), {"loot": 1} if id == 457 else {"coins": 3}, "%d только напечатанная награда" % id)
	var rag = _post16(t, 459)
	t.equal(rag.g.hands[0].size(), 6, "459 три добычи до броска возврата")
	_die(rag, 1)
	t.check(rag.g.monsters.any(func(monster): return int(monster.id) == 459), "459 единица вернула карту через пополнение ряда")
	t.equal(rag.g.souls[0], 0, "459 возврат заменяет получение души")
	var bloat = _monster(t, 460)
	_trigger(bloat, "damage", {"seat": 0, "monster": 460, "amount": 2, "combat": true})
	t.equal(bloat.g.hp, [2, 1, 1], "460 боевой урон повреждает всех не-активных")
	var horf = _monster(t, 461)
	horf.g.max_hp[0] = 5
	horf.g.hp[0] = 5
	_attack_roll17(horf, 2)
	t.equal(horf.g.hp[0], 3, "461 двойка добавляет1к боевому урону")
	var chub = _monster(t, 462, {"hp": 1})
	_attack_roll17(chub, 1)
	t.equal(int(chub.g.monsters[0].hp), 3, "462 единица лечит2HP")
	t.equal(chub.g._printed_monster_reward(462), {"coins": 7, "souls": 1}, "462 напечатанная душа учтена")
	var bony = _monster(t, 463)
	_trigger(bony, "monster_death", {"seat": 2, "card": 463})
	t.equal(bony.g.hp[2], 1, "463 урон именно убившему игроку")
	var glut = _monster(t, 464)
	_trigger(glut, "combat_monster_damage", {"seat": 0, "card": 464, "amount": 1, "value": 6})
	t.equal(glut.g.hp[1], 1, "464 шестёрка наносит1соседу слева")
	t.equal(glut.g._printed_monster_reward(464), {"loot": 1, "souls": 1}, "464 одна добыча по оригиналу")
	var pest = _monster(t, 465)
	_trigger(pest, "monster_death", {"seat": 0, "card": 465})
	pest.choose(0, "split_damage16", {"zone": "player", "target": 1})
	pest.choose(0, "split_damage16", {"zone": "monster", "target": 1})
	t.equal(pest.g.hp[1], 1, "465 первая единица игроку")
	t.equal(int(pest.g.monsters[1].hp), 7, "465 вторая единица монстру")
	var creep = _monster(t, 466)
	_trigger(creep, "damage", {"seat": 0, "monster": 466, "amount": 2})
	t.equal(creep.g.hp[1], 0, "466 полный урон повторён левому соседу")
