extends RefCounted
## Сорок событий/комнат: короткие отдельные сценарии вместо длинной партии.
const Scenario := preload("res://tests/fs/fs_scenario.gd")
const Check := preload("res://tests/fs/fs_check.gd")
const Cards := preload("res://games/four_souls/logic/fs_encounter_cards.gd")

func _game(t: Check) -> RefCounted:
	var s := Scenario.new(t).players(3).dlc().current(0).character(0, 821).character(1, 821).character(2, 821) \
		.no_items(0).no_items(1).no_items(2).hand(0, [549, 480, 481]).hand(1, [482]).hand(2, [483]) \
		.monster(0, 423).monster(1, 427).room(-1).coins(0, 8).coins(1, 8).coins(2, 8) \
		.deck_top("treasure", [229, 143, 147, 117, 112, 249, 174, 79]).build()
	s.g.bonuses.clear()
	return s

func _event(s: RefCounted, id: int) -> void:
	s._take(id)
	s.g._push({"kind": "event", "card": id, "owner": 0}, "turn")
	s.close()

func _room(s: RefCounted, id: int) -> void:
	s._take(id)
	s.g.room = id
	s.g._reset_room_goals()

func run(t: Check) -> void:
	t.equal(Cards.IDS.size(), 40, "Пакет11 содержит40разныхкарт")
	# Каждая строка таблицы проверяет ресурсы после одного события.
	for id in [699, 701, 702, 704, 713, 714, 722, 726]:
		for face in [1, 2, 3, 4, 5, 6]:
			var s = _game(t)
			_event(s, id)
			s.roll(face)
			s.ok(0, "effect_roll")
			s.close()
			match id:
				699:
					t.equal(s.g.coins[0], 9 if face <= 2 else 8, "699монеты по таблице")
					t.equal(s.g.hands[0].size(), 5 if face in [3, 4] else 3, "699добор по таблице")
					t.equal(s.g.hp[0], 0 if face >= 5 else 2, "699урон по таблице")
				701: t.equal(s.g.hands[0].size(), 3 + (1 if face <= 2 else 2 if face <= 4 else 3), "701три ступени добычи")
				702: t.equal(s.g.coins[0], 8 + (1 if face <= 2 else 3 if face <= 4 else 6), "702три ступени монет")
				704:
					if face == 6:
						t.check(not s.g._card_choices().is_empty(), "704поиск предлагает предметы Гаппи")
						s.choose(0, "guppy_take")
						t.check(s.g.items[0].any(func(item): return str(FSData.card(int(item.id)).key).begins_with("guppy")), "704выбранный Гаппи получен")
					else: t.equal(s.g.hp[0], 1 if face <= 3 else 0, "704урон1или2")
				713:
					t.equal(s.g.items[0].size(), 2 if face <= 2 else 1, "713сокровище на1–2")
					t.equal(s.g.coins[0], 8 if face <= 2 else 13 if face <= 4 else 15, "713монеты5или7")
				714: t.equal(s.g.hands[0].size(), 3 if face <= 2 else 4 if face <= 4 else 5, "714добыча1или2")
				722:
					t.equal(s.g.souls[0], 1 if face == 6 else 0, "722физическая душа на6")
					if face == 6: t.equal(s.zone_of(722), "soul:0", "722не дублируется в сбросе")
					elif face <= 2:
						t.equal(s.g.damage_shields[0], 2, "722защита двух следующих единиц")
						t.equal(s.g.attack_left, 2, "722дополнительная атака")
					else: t.equal(s.g.coins[0], 15, "722семь монет")
				726:
					t.equal(s.g.items[0].size(), 3 if face == 1 else 2 if face <= 3 else 1, "726сокровища2или1")
					t.equal(s.g.hands[0].size(), 5 if face >= 4 else 3, "726две добычи на4–6")
	for id in [698, 720, 733, 712]:
		var s = _game(t)
		_event(s, id)
		t.equal(s.g.hp, [0, 0, 0] if id == 712 else [0, 2, 2], "Тролль-бомба: правильные адресаты2урона")
	var shop = _game(t)
	var shop_size: int = shop.g.shop.size()
	_event(shop, 697)
	t.equal(shop.g.shop.size(), shop_size + 2, "697расширяет магазин на2")
	t.equal(shop.g.attack_left, 2, "697ещё одна атака")
	for mode in 3:
		var s = _game(t)
		_event(s, 710)
		s.choose(0, "devil_deal", {"mode": mode})
		t.equal(s.g.hands[0].size(), 5 if mode == 1 else 3, "710добор только при выборе второй ветки")
		t.equal(s.g.hp[0], 2 - mode, "710урон выбранной ветки")
		if mode == 2: s.choose(0, "guppy_take")
	var ambush = _game(t)
	_event(ambush, 715)
	t.equal(ambush.g._forced_deck_remaining(), 2, "715две обязательные атаки верха")
	ambush.no(0, "end", null, "715нельзя обойти конец хода")
	ambush.no(0, "attack", {"slot": 0}, "715нельзя атаковать открытый слот")
	var xl = _game(t)
	_event(xl, 717)
	t.equal(xl.g.monster_slots, 3, "717расширяет число слотов")
	t.equal(xl.g.attack_left, 2, "717добавляет атаку")
	var order = _game(t)
	_event(order, 718)
	var picked: int = int(order.g.peek.cards[0])
	order.choose(0, "order_card", {"card": picked})
	while not order.g.peek.is_empty(): order.choose(0, "order_card")
	t.equal(int(order.g.hands[0].back()), picked, "718сначала выбран порядок, затем взята первая карта")
	t.check(order.g.get_view(1).peek.is_empty(), "718не раскрывает приватный просмотр соседу")
	var discard = _game(t)
	_event(discard, 721)
	discard.choose(0, "discard_loot")
	discard.choose(0, "discard_loot")
	t.equal(discard.g.hands[0].size(), 1, "721сброшены ровно2выбранныхкарты")
	var bosses = _game(t)
	for id in [348, 395, 700]:
		bosses._take(id)
		bosses.g.decks.monster.append(id)
	_event(bosses, 725)
	t.check(700 in bosses.g.discards.monster, "725события между боссами сброшены без разрешения")
	t.equal(bosses.g.get_view(1).peek.cards.size(), 2, "725открытые боссы видны всем")
	bosses.choose(0, "boss_rush_place", {"item": 0})
	bosses.choose(0, "boss_rush_place", {"item": 1})
	bosses.no(0, "end", null, "725обязательная атака одного босса")
	bosses.ok(0, "attack", {"slot": 1})
	t.check(bosses.g._forced_bosses.is_empty(), "725одна объявленная атака выполняет требование")
	for id in [728, 735]:
		var s = _game(t)
		_event(s, id)
		s.choose(0, "attach_curse", {"target": 1})
		t.check(id in s.g.curses[1] and id not in s.g.discards.monster, "Проклятие прикреплено к выбранному игроку")
		if id == 735:
			s.g._emit_passives("monster_death", {"seat": 0, "card": 427})
			s.close()
			s.choose(1, "discard_loot")
			t.equal(s.g.coins[1], 7, "735владелец теряет1монету")
			t.equal(s.g.hands[1].size(), 0, "735владелец сам выбирает сброс")
	var pit = _game(t)
	_event(pit, 731)
	pit.close()
	t.equal(pit.g.current, 1, "731автоматически завершает ход после штатного окна конца хода")
	t.check(731 in pit.g.discards.monster, "731сброшена один раз")
	var replay = _game(t)
	replay._take(143)
	replay.g._gain_item(0, 143)
	_event(replay, 732)
	replay.choose(0, "replay_chosen", {"item": 1})
	replay.choose(0, "skip_choice")
	t.check(143 in replay.g.discards.treasure, "732выбранный исходный предмет заменён")
	t.equal(replay.g.items[0].size(), 2, "732предмет заменён ровно одним новым")
	var overflow = _game(t)
	_event(overflow, 734)
	for seat in 3:
		t.equal(overflow.g.actor(), seat, "734бросает очередной настоящий игрок")
		overflow.roll(1 if seat == 1 else 6)
		overflow.ok(seat, "effect_roll")
		overflow.close()
	t.equal(overflow.g.skipped_turns, [0, 1, 0], "734пропускает ход только выбросивший1–2")
	for face in [1, 3, 5, 6]:
		var s = _game(t)
		s._take(143); s.g._gain_item(1, 143)
		s._take(348); s.g._gain_soul_card(1, {"id": 348, "value": 1})
		_event(s, 738)
		s.choose(0, "betray_target", {"target": 1})
		s.roll(face); s.ok(0, "effect_roll"); s.close()
		if face == 5: s.choose(0, "steal")
		if face == 6: s.choose(0, "steal_soul")
		t.check((s.g.coins[0] == 13) if face == 1 else (s.g.hands[1].is_empty()) if face == 3 else (s.g._item_count(0, 143) == 1) if face == 5 else (s.g.souls[0] == 1), "738выполнена соответствующая ветка кражи")
	var shadow = _game(t)
	shadow._take(143); shadow.g._gain_item(1, 143)
	_event(shadow, 739)
	t.equal(shadow.g.hp, [2, 0, 2], "739погиб владелец большинства предметов")
	t.equal(shadow.g.decks.monster.find(739), shadow.g.decks.monster.size() - 7, "739под шестью верхними картами")
	var gold = _game(t)
	_event(gold, 740)
	gold.choose(0, "damage", {"target": 2})
	t.equal(gold.g.hp[2], 0, "740два урона выбранному игроку")
	t.equal(gold.g.decks.monster.find(740), gold.g.decks.monster.size() - 5, "740под четырьмя верхними картами")
	var lust = _game(t)
	lust._take(143); lust.g._gain_item(1, 143)
	_event(lust, 741)
	lust.choose(0, "lust_target", {"target": 1})
	lust.no(0, "end", null, "741обязательная атака выбранного игрока")
	t.equal(lust.g._permitted_player_attack_targets(), [1], "741доступна только назначенная цель")
	lust.ok(0, "attack_player", {"target": 1})
	lust.close()
	lust.g.hp[1] = 0; lust.g._check_deaths(); lust.close()
	lust.ok(1, "death", {"loot": 482, "item": 1})
	t.equal(lust.g._item_count(0, 143), 1, "741предмет штрафа передан активному игроку")
	var double = _game(t)
	_event(double, 742)
	double.choose(0, "double_treasure", {"target": 2})
	t.equal(double.g.items.map(func(inventory): return inventory.size()), [2, 1, 2], "742два правильных получателя сокровищ")
	for face in [1, 6]:
		var barrel = _game(t)
		_event(barrel, 743)
		barrel.choose(0, "barrel_target", {"zone": "player", "target": 1})
		barrel.roll(face); barrel.ok(0, "effect_roll"); barrel.close()
		t.equal(barrel.g.hp, [0, 0, 2] if face <= 4 else [2, 0, 2], "743урон по обеим веткам")
	_rooms(t)

func _rooms(t: Check) -> void:
	var no_souls = _game(t)
	_room(no_souls, 779)
	_event(no_souls, 722)
	no_souls.roll(6); no_souls.ok(0, "effect_roll"); no_souls.close()
	t.equal(no_souls.g.souls[0], 0, "779предотвратил душу сундука")
	no_souls._take(243); no_souls.g._gain_item(0, 243)
	no_souls.g._destroy_item(0, 1)
	t.equal(no_souls.g.souls[0], 0, "779блокирует также превращение Сундука")
	t.equal(no_souls.zone_of(243), "discard:treasure", "779не теряет физический Сундук при запрете души")
	var lost = _game(t)
	_room(lost, 779)
	lost._take(475); lost.g.hands[0].append(475)
	lost.ok(0, "loot", {"card": 475}); lost.close()
	t.equal(lost.g.souls[0], 0, "779блокирует Потерянную душу из лута")
	t.equal(lost.zone_of(475), "discard:loot", "Заблокированный лут остаётся физической картой")
	var planet = _game(t)
	_room(planet, 803)
	planet.g._emit_passives("turn_start"); planet.close()
	planet.choose(0, "treasure")
	t.equal(planet.g.items[0].size(), 2, "803необязательное сокровище получено автоматически")
	var tax = _game(t)
	_room(tax, 804)
	tax._take(348); tax.g._gain_soul_card(0, {"id": 348, "value": 1})
	tax.ok(0, "attack", {"slot": 0})
	t.equal(tax.g.coins, [4, 10, 10], "804по2монеты каждому соседу перед атакой")
	var equality = _game(t)
	_room(equality, 807)
	equality.g._gain_coins(1, 3)
	t.equal(equality.g.coins, [11, 11, 11], "807каждый получил исходную сумму без рекурсии")
	equality._take(137); equality.g._gain_item(0, 137)
	equality.g._gain_coins(1, 1); equality.close()
	t.equal(equality.g.coins, [14, 11, 11], "807иМагнит: передача не запускает новое получение из банка")
	var goals = _game(t)
	_room(goals, 810)
	goals.no(0, "room", null, "810не сбрасывается раньше четырёх целей")
	for count in 5: goals.g._emit_passives("loot_play", {"seat": 0})
	for count in 3: goals.g._emit_passives("monster_death", {"seat": 0})
	goals.g._transfer_coins(0, 1, 6)
	for count in 3: goals.g._emit_passives("roll", {"seat": 2, "value": 6})
	goals.close()
	t.equal(goals.g.items.map(func(inventory): return inventory.size()), [3, 3, 3], "810четыре общие цели выдали каждому2сокровища")
	goals.g._emit_passives("purchase", {"seat": 0})
	goals.close()
	t.equal(goals.g.items[0].size(), 3, "810награда не повторяется")
	var twin = _game(t)
	_room(twin, 811)
	twin.g._emit_passives("monster_death", {"seat": 1, "card": 427}); twin.close()
	twin.choose(1, "encounter_kill", {"target": 2})
	t.equal(twin.g.hp[2], 0, "811убийца выбирает другого игрока")
	var war = _game(t)
	_room(war, 813)
	for id in [143, 147]: war._take(id); war.g._gain_item(1, id)
	war.g.hp[1] = 0; war.g._check_deaths(); war.close()
	war.choose(1, "destroy", {"item": 1})
	t.check(143 in war.g.discards.treasure and war.g._item_count(1, 147) == 1, "813дополнительное уничтожение раньше обычного штрафа")
	var famine = _game(t)
	_room(famine, 814)
	famine.g.free_loot = 3
	famine.ok(0, "loot", {"card": 549}); famine.close()
	famine.no(0, "loot", {"card": 480}, "814не более одного лута даже с дополнительным правом")
	famine._take(40); famine.g._gain_item(0, 40)
	famine.ok(0, "activate", {"item": 1}); famine.close()
	famine.no(0, "activate", {"item": 0}, "814не более одной активации")
	for id in [728, 815]:
		var recharge = _game(t)
		if id == 728: recharge._take(id); recharge.g.curses[0].append(id)
		else: _room(recharge, id)
		recharge._take(40); recharge.g._gain_item(0, 40)
		recharge.g.items[0][0].tapped = true; recharge.g.items[0][1].tapped = true
		var hand_before: int = recharge.g.hands[0].size()
		recharge.g._begin_turn(); recharge.close()
		t.equal(recharge.g.hands[0].size(), hand_before, "Ограниченная перезарядка предшествует добору")
		recharge.choose(0, "recharge", {"item": 1})
		t.equal(recharge.g.hands[0].size(), hand_before + 1, "После перезарядки выполнен обычный добор")
		t.check(recharge.g.items[0][0].tapped and not recharge.g.items[0][1].tapped, "728/815перезаряжен только выбранный предмет")
	var splash = _game(t)
	_room(splash, 817)
	splash.g._emit_passives("monster_damage", {"seat": 1, "amount": 2, "card": 427}); splash.close()
	t.equal(splash.g.hp, [2, 2, 1], "817ровно1урон соседу слева от источника")
