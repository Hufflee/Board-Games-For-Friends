extends "res://tests/fs/core/core_automation_batch14.gd"
## Пакет15: один общий прогон сорока текстов, включая совместную атаку и физические зоны.
const Scenario := preload("res://tests/fs/fs_scenario.gd")
const Packet := preload("res://games/four_souls/logic/fs_packet15_cards.gd")
func _monster(t: Check, id: int, fields: Dictionary = {}) -> RefCounted:
	var s := Scenario.new(t).players(3).dlc().current(0).character(0, 821).character(1, 821).character(2, 821) \
		.no_items(0).no_items(1).no_items(2).hand(0, [549, 480, 481]).hand(1, [482, 483]).hand(2, [484]) \
		.monster(0, id, fields).monster(1, 423, {"hp": 8}).room(-1).coins(0, 8).coins(1, 9).coins(2, 8).build()
	s.g.bonuses.clear()
	return s
func _hit(s: RefCounted, amount: int) -> void:
	s.operation_panel()
	s.effect(0, "monster_damage", {"item": 0, "amount": amount})
	s.ok(0, "effect_done")
	s.close()
func run(t: Check) -> void:
	t.equal(Packet.IDS.size(), 40, "Пакет15: сорок полных текстов")
	var bum = _game(t, 246)
	_trigger(bum, "turn_start", {"seat": 0})
	_die(bum, 2)
	t.equal(bum.g.coins[0], 11, "246 начало хода даёт результат таблицы")
	var shadow = _game(t, 247)
	_item(shadow, 1, 143)
	shadow.g.hp[1] = 0
	shadow.g._death_queue = [1]
	shadow.g._push({"kind": "death", "owner": 1}, "turn")
	shadow.close()
	t.equal(shadow.g._card_choice_owner(), 0, "247 предмет для чужого штрафа выбирает владелец Тени")
	shadow.choose(0, "shadow_item15", {"target": 1, "item": 1})
	shadow.close()
	shadow.ok(1, "death", {"loot": 482, "item": -1})
	t.check(482 in shadow.g.hands[0], "247 потерянная карта получена Тенью")
	t.equal(shadow.g.coins[0], 9, "247 монета передана без банка")
	t.check(143 in shadow.g.discards.treasure, "247 выбранный предмет уничтожен")
	var tech = _game(t, 248)
	_activate(tech)
	t.equal(int(tech.g.items[0][1].counters), 1, "248 поворот добавляет жетон")
	tech.g.items[0][1].counters = 3
	tech.ok(0, "activate", {"item": 1, "ability": "kill"})
	t.equal(int(tech.g.items[0][1].counters), 0, "248 три жетона оплачены до окна")
	tech.close()
	tech.choose(0, "kill15", {"zone": "monster", "target": 0})
	t.check(int(tech.g.monsters[0].hp) <= 0 or 423 in tech.g.discards.monster, "248 выбранный монстр убит")
	var photo = _game(t, 250)
	photo.g.discards.loot.append_array(photo.g.hands[0])
	photo.g.hands[0].clear()
	_trigger(photo, "turn_end", {"seat": 0})
	t.equal(photo.g.hands[0].size(), 2, "250 пустая рука в конце хода даёт2карты")
	var chaos = _game(t, 251)
	var old: Array = chaos.g.hands.duplicate(true)
	_activate(chaos)
	t.equal(chaos.g.hands[1], old[0], "251 руки переданы одновременно влево")
	t.equal(chaos.g.hands[0], old[2], "251 последняя рука замкнула круг")
	var crystal = _game(t, 252)
	_activate(crystal)
	crystal.choose(0, "crystal_face15", {"face": 4})
	_trigger(crystal, "roll", {"seat": 2, "value": 4})
	t.equal(crystal.g.hands[0].size(), 6, "252 угаданный следующий бросок даёт3карты")
	_trigger(crystal, "roll", {"seat": 1, "value": 4})
	t.equal(crystal.g.hands[0].size(), 6, "252 предсказание использовано один раз")
	var jaw = _game(t, 253)
	_activate(jaw)
	jaw.choose(0, "steal_coins", {"target": 1})
	t.equal(jaw.g.coins, [11, 6, 8], "253 украдены3монеты")
	var belt = _game(t, 254)
	t.equal(belt.g.attack[0], 1, "254 бонус относится только к первому броску")
	belt.g._turn_allowances()
	t.equal(belt.g.attack_left, 2, "254 дополнительная атака")
	belt.g.battle = 0
	belt.g._push({"kind": "roll", "owner": 0, "value": 6}, "battle_roll")
	belt.close()
	t.equal(int(belt.g.monsters[0].hp), 6, "254 первый успешный бросок наносит2урона")
	var paw = _game(t, 255)
	_activate(paw)
	paw.g._damage_player(0, 1)
	paw.close()
	paw.choose(0, "damage", {"target": 2})
	t.equal(paw.g.hp, [2, 2, 1], "255 предотвращённая единица вызывает урон другому игроку")
	var shield = _game(t, 256)
	shield.no(1, "loot", {"card": 482}, "256 запрещает чужой розыгрыш")
	_item(shield, 1, 192)
	shield.no(1, "activate", {"item": 1}, "256 запрещает чужую активацию")
	var box = _game(t, 257)
	_activate(box)
	_die(box, 6)
	t.equal(box.g.souls[0], 1, "257 после уничтожения становится физической душой")
	t.check(257 not in box.g.discards.treasure, "257 душа не дублируется в сбросе")
	var spitty = _monster(t, 258)
	spitty._take(475)
	spitty.g._gain_soul_card(0, {"id": 475, "value": 1})
	spitty.g.battle = 0
	spitty.g.phase = "battle_roll"
	spitty.roll(6)
	spitty.ok(0, "roll")
	spitty.close()
	_die(spitty, 2)
	spitty.close()
	t.equal(spitty.g.last_roll, 2, "258 из двух кубиков выбран меньший")
	var trap = _monster(t, 259)
	_trigger(trap, "turn_start", {"seat": 0})
	_die(trap, 6)
	t.check(259 in trap.g._forced_monsters14, "259 результат4–6 заставляет атаковать")
	_trigger(trap, "monster_damage", {"seat": 1, "card": 259, "amount": 1})
	t.equal(trap.g.hp[0], 1, "259 ответный урон активному игроку")
	var baby = _monster(t, 260, {"hp": 1})
	_trigger(baby, "monster_damage", {"seat": 0, "card": 260, "amount": 1})
	var health := 0
	var attack_tokens := 0
	for entry: Dictionary in baby.g.monsters:
		health += int(entry.get("health_tokens15", 0))
		attack_tokens += int(entry.get("attack_tokens15", 0))
	t.equal(health, 1, "260 выдан один жетон здоровья")
	t.equal(attack_tokens, 1, "260 выдан один жетон атаки")
	var spider = _monster(t, 261)
	spider.g._spider_tokens15[0] = 1
	_trigger(spider, "turn_start", {"seat": 0})
	var dice := 0
	while spider.g.phase == "effect" and str(spider.g._card_step().get("op", "")) == "auto_roll" and dice < 4:
		_die(spider, 6)
		dice += 1
	t.check(dice >= 1, "261 за каждый свой жетон выполняется бросок")
	spider.ok(0, "remove_spider15")
	t.check(not bool(spider.g.character_ready[0]), "261 удаление жетона поворачивает персонажа")
	var clot = _monster(t, 262)
	_trigger(clot, "turn_start", {"seat": 0})
	t.equal(int(clot.g.monsters[0].hp), 2, "262 жетон уменьшает здоровье")
	_trigger(clot, "attack_roll", {"seat": 1, "value": 1})
	t.equal(clot.g.hp, [0, 0, 0], "262 боевая1 повреждает всех на2")
	var bomb = _monster(t, 263)
	_trigger(bomb, "turn_start", {"seat": 0})
	t.equal(int(bomb.g.monsters[1].get("attack_tokens15", 0)), 1, "263 жетон только другому случайному монстру")
	t.equal(bomb.g._monster_attack(bomb.g.monsters[1]), 2, "263 жетон увеличивает урон монстра")
	var rider = _monster(t, 264, {"hp": 0})
	t.check(rider.g._replace_monster_death(0), "264 смерть не от6предотвращена")
	t.equal(int(rider.g.monsters[0].hp), 2, "264 полное лечение")
	var button = _monster(t, 265)
	_trigger(button, "monster_damage", {"seat": 0, "card": 265, "amount": 1})
	_die(button, 5)
	t.equal(button.g.coins[0], 13, "265 повреждение запускает таблицу результата")
	var poop = _monster(t, 266, {"hp": 5})
	poop.ok(0, "attack", {"slot": 0})
	poop.close()
	poop.roll(6)
	poop.ok(0, "roll")
	poop.close()
	t.equal(poop.g.actor(), 1, "266 после активного бросает следующий участник")
	poop.roll(6)
	poop.ok(1, "roll")
	poop.close()
	t.equal(poop.g.actor(), 2, "266 участники совместной атаки идут по порядку")
	t.equal(poop.g.hands[1].size(), 3, "266 наносивший урон получил добычу")
	var eternal = _monster(t, 267)
	_item(eternal, 1, 143)
	_trigger(eternal, "monster_death", {"seat": 0, "card": 267})
	eternal.choose(0, "eternal_token15", {"target": 1, "item": 1})
	t.check(bool(eternal.g.items[1][1].eternal), "267 выбранный предмет навсегда вечный")
	var pvp = _monster(t, 268, {"hp": 0})
	pvp.g._continue_stack()
	pvp.close()
	t.check(pvp.g.required_player_attacks > 0, "268 смерть выдаёт обязательную дополнительную атаку игрока")
	var numbers = _monster(t, 269)
	_trigger(numbers, "turn_start", {"seat": 0})
	for seat in 3:
		t.equal(numbers.g._card_choice_owner(), seat, "269 число выбирается по порядку хода")
		numbers.choose(seat, "number15", {"face": seat + 1})
	_trigger(numbers, "roll", {"seat": 0, "value": 2})
	t.equal(numbers.g.hp, [2, 1, 2], "269 урон получает выбравший выпавшее число")
	var coil = _monster(t, 270)
	var old_coil: Array = coil.g.hands.duplicate(true)
	coil.g._monster_entered15(coil.g.monsters[0])
	coil.close()
	t.equal(coil.g.hands[0], old_coil[1], "270 вход передаёт руки вправо")
	coil.g.monsters[0].hp = 0
	coil.g._continue_stack()
	coil.close()
	t.equal(int(coil.g.decks.monster[coil.g.decks.monster.size() - 4]), 270, "270 после возврата под4верхние пополнение ряда сняло одну верхнюю")
	var vote = _monster(t, 271)
	_trigger(vote, "turn_start", {"seat": 0})
	for seat in 3:
		vote.choose(seat, "vote15", {"naughty": seat != 2})
	t.check(271 in vote.g._forced_monsters14, "271 большинство озорных заставляет атаковать")
	var bin = _monster(t, 272)
	_item(bin, 1, 243)
	bin.g.hp[1] = 0
	bin.g._death_queue = [1]
	bin.g.phase = "death"
	bin.ok(1, "death", {"loot": 482, "item": 1})
	t.check(243 in bin.g.shop and bin.g.souls[1] == 0, "272 предмет штрафа в магазине без уничтожения")
	t.check(bin.g._untargetable(272), "272 нельзя атаковать")
	var hush = _monster(t, 273)
	hush.ok(0, "attack", {"slot": 0})
	hush.close()
	hush.roll(6)
	hush.ok(0, "roll")
	t.equal(hush.g._card_choice_owner(), 2, "273 число сначала выбирает левый сосед")
	hush.choose(2, "neighbor_face15", {"face": 6})
	hush.choose(1, "neighbor_face15", {"face": 2})
	hush.close()
	t.equal(int(hush.g.monsters[0].hp), 8, "273 названный результат считается промахом")
	var cry = _monster(t, 274, {"hp": 3})
	cry.g.battle = 0
	_trigger(cry, "monster_damage", {"seat": 0, "card": 274, "amount": 1})
	cry.choose(0, "move_monster15", {"item": 1})
	t.equal(cry.g.battle, -1, "274 атака отменена")
	t.equal(int(cry.g.monsters[0].id), 274, "274 карта перемещена в другой слот с накрытием")
	t.equal(cry.g.hands[0].size(), 4, "274 активный игрок взял добычу")
	var vis = _game(t, 40)
	_item(vis, 1, 275)
	var target: int = vis.g._familiar_targets15().find({"zone": "item", "seat": 1, "index": 1, "card": 275})
	vis.ok(0, "attack_familiar15", {"index": target})
	vis.close()
	vis.g.monsters.back().hp = 0
	vis.g.monsters.back()["slayer"] = 0
	vis.g._continue_stack()
	vis.close()
	t.equal(vis.g._item_count(0, 275), 1, "275 убитый другим игроком спутник украден")
	vis.inv("275 физическая карта существует в одном инвентаре")
	var fat = _monster(t, 276)
	fat.ok(0, "attack", {"slot": 0})
	fat.close()
	t.equal(int(fat.g.monsters[0].hp), 5, "276 три карты в руке добавили3здоровья")
	var curse = _monster(t, 277)
	curse._take(705)
	curse.g.decks.monster.append(705)
	curse.ok(0, "attack", {"slot": 0})
	curse.close()
	t.check(705 in curse.g.curses[0], "277 раскопано и получено проклятие")
	t.equal(curse.g._monster_attack(curse.g.monsters[0]), 1, "277 атака равна количеству проклятий активного игрока")
	var ghost = _game(t, 40)
	ghost._take(278)
	ghost.g._gain_soul_card(1, {"id": 278, "value": 1})
	ghost.ok(0, "attack_familiar15", {"index": 0})
	ghost.close()
	t.equal(int(ghost.g.monsters.back().dc), 4, "278 душа получает дополнительную защиту")
	ghost.g.monsters.back().hp = 0
	ghost.g.monsters.back()["slayer"] = 0
	ghost.g._continue_stack()
	ghost.close()
	t.equal(ghost.g.souls, [1, 0, 0], "278 атакованная душа украдена без дублирования")
	ghost.inv("278 одна физическая душа")
	var miser = _monster(t, 279)
	t.equal(miser.g._purchase_cost(0, 0), 7, "279 магазин дешевле на3")
	_trigger(miser, "purchase", {"seat": 1, "slot": 0, "cost": 7})
	t.equal(int(miser.g.monsters[0].get("counters", 0)), 7, "279 жетоны равны фактически уплаченным монетам")
	var bloat = _monster(t, 280)
	_trigger(bloat, "loot_play", {"seat": 2, "card": 549})
	_hit(bloat, 4)
	t.equal(int(bloat.g.monsters[0].hp), 3, "280 один жетон предотвращает всё событие урона")
	t.equal(bloat.g.hands[0].size(), 4, "280 активный игрок взял карту при предотвращении")
	var boss = _monster(t, 281)
	boss.g.battle = 0
	boss.g._push({"kind": "roll", "owner": 0, "value": 4}, "battle_roll")
	boss.close()
	boss.g._push({"kind": "roll", "owner": 0, "value": 4}, "battle_roll")
	boss.close()
	t.equal(int(boss.g.monsters[0].hp), 5, "281 равный предыдущему бросок промахнулся")
	var eyes = _monster(t, 282)
	_trigger(eyes, "monster_death", {"seat": 0, "card": 423})
	t.equal(eyes.g.hp, [1, 1, 1], "282 смерть монстра повреждает всех игроков")
	t.equal(int(eyes.g.monsters[1].hp), 7, "282 смерть повреждает другого монстра")
	var mother = _monster(t, 283)
	_item(mother, 1, 143)
	_trigger(mother, "monster_death", {"seat": 0, "card": 283})
	mother.choose(0, "item_health15", {"target": 1, "item": 1})
	t.equal(mother.g.max_hp[1], 3, "283 жетон здоровья привязан к чужому предмету")
	var dad = _monster(t, 284, {"hp": 0})
	t.check(dad.g._replace_monster_death(0), "284 первая смерть предотвращена")
	dad.close()
	t.equal(int(dad.g.monsters[0].counters), 1, "284 получен жетон")
	t.equal(dad.g.battle, -1, "284 атака отменена")
	var victory = _monster(t, 285, {"hp": 0})
	victory.g._continue_stack()
	victory.close()
	t.equal(victory.g.winner, 0, "285 единственный лидер по душам победил")
	var gum = _monster(t, 286)
	for index in 6:
		_trigger(gum, "death", {"seat": 1})
	_trigger(gum, "turn_start", {"seat": 0})
	t.equal(gum.g._monster_attack(gum.g.monsters[0]), 7, "286 каждый жетон добавил атаку")
	t.check(286 in gum.g._forced_monsters14, "286 шесть жетонов заставляют атаковать")
