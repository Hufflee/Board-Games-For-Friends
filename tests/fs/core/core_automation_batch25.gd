extends "res://tests/fs/core/core_automation_batch24.gd"
## Стартовые предметы, платные комнаты и сохранение физической души комнаты.
func run(t: Check) -> void:
	var shield = _game(t, 824)
	_activate(shield)
	shield.choose(0, "shield_event21", {"zone": "player", "target": 1})
	shield.g._damage_player(1, 4, {"monster": 423})
	t.equal(shield.g.hp[1], 2, "824 предотвращает целое следующее событие урона")
	shield.g._damage_player(1, 1, {"monster": 423})
	t.equal(shield.g.hp[1], 1, "824 щит расходуется один раз")
	var blue = _game(t, 830)
	_activate(blue)
	blue.choose(0, "blue_modes25", {"mode": "coin"})
	blue.choose(0, "blue_steal25", {"target": 1})
	t.equal(blue.g.coins, [9, 8, 8], "830 крадёт монету вместо получения из банка")
	blue.g._damage_player(0, 1, {"monster": 423})
	blue.close()
	t.check(not bool(blue.g.items[0][1].tapped), "830 перезаряжается от полученного урона")
	var pit = _game(t, 836)
	pit.ok(0, "attack", {"slot": 0})
	pit.ok(0, "activate", {"item": 1})
	pit.close()
	t.equal(pit.g.battle, -1, "836 отменяет объявленную атаку до первого броска")
	t.equal(pit.g.attack_left, 1, "836 возвращает дополнительную возможность атаки")
	var incubus = _game(t, 841)
	_activate(incubus)
	incubus.choose(0, "incubus_modes25", {"mode": "swap"})
	incubus.choose(0, "incubus_peek25", {"target": 1})
	t.check(incubus.g.get_view(2).peek.is_empty(), "841 просмотр руки остаётся частным")
	incubus.choose(0, "incubus_give25", {"item": 0})
	incubus.choose(0, "incubus_swap25", {"item": 0})
	t.check(482 in incubus.g.hands[0] and 549 in incubus.g.hands[1], "841 меняет выбранные физические карты")
	var bone = _game(t, 843)
	_activate(bone)
	t.equal(int(bone.g.items[0][1].counters), 1, "843 поворот добавляет жетон")
	bone.g.items[0][1].counters = 5
	bone.ok(0, "activate", {"item": 1, "ability": "bone5"})
	bone.close()
	t.equal(bone.zone_of(843), "soul:0", "843 платная способность превращает вечную Кость в душу")
	var chest = _game(t, 71)
	_room24(chest, 776)
	chest.ok(0, "room_activate24", {"index": -1})
	chest.choose(0, "room_loot_cost25", {"item": 0})
	_die(chest, 5)
	t.equal(chest.g.coins[0], 15, "776 пятёрка выдала7¢ после сброса")
	t.check(549 in chest.g.discards.loot, "776 оплачена выбранная физическая карта")
	var bomb = _game(t, 71)
	_room24(bomb, 775)
	bomb.ok(0, "room_activate24", {"index": -1})
	bomb.choose(0, "room_bomb_cost24", {"item": 0})
	t.check(549 in bomb.g.discards.loot, "775 оплачена выбранная карта добычи")
	t.equal(str(bomb.g._card_step().op), "auto_roll", "775 переходит к броску после оплаты")
	var coop = _game(t, 71)
	_room24(coop, 778)
	coop.ok(0, "room_attack24", {"index": -1})
	coop.close()
	t.equal(coop.g.actor(), 1, "778 первым бросает неактивный игрок")
	_die(coop, 4)
	coop.close()
	_die(coop, 2)
	coop.close()
	t.equal(coop.g._coop_partners20, [1], "778 только успех другого игрока даёт совместную атаку")
	t.equal(int(coop.g.monsters[coop.g.battle].hp), 9, "778 напечатанное здоровье комнаты9")
	coop.g.monsters[coop.g.battle].hp = 1
	coop.roll(6)
	coop.ok(0, "roll")
	coop.close()
	t.equal(coop.zone_of(778), "soul:0", "778 физическая комната стала душой активного")
	t.equal(coop.g.items.map(func(row): return row.size()), [3, 2, 2], "778 каждое место получило по сокровищу")
	var dice = _game(t, 71)
	_room24(dice, 790)
	dice.close()
	t.equal(dice.g.hands.map(func(hand): return hand.size()), [3, 3, 3], "790 сама заменила руки при входе")
	t.check(549 in dice.g.discards.loot, "790 прежние руки физически сброшены")
	dice.ok(0, "end")
	dice.close()
	t.check(dice.g.room != 790, "790 ушла в конце хода")
	var rage = _game(t, 71)
	_room24(rage, 792)
	rage.g.monsters[0].hp = 1
	rage.ok(0, "attack", {"slot": 0})
	rage.roll(6)
	rage.ok(0, "roll")
	rage.close()
	_die(rage, 4)
	rage.close()
	rage.no(0, "end", null, "792 не разрешает конец хода до обязательной атаки")
	rage.ok(0, "attack", {"slot": 0})
	rage.close()
	t.equal(rage.g._mandatory_attacks25, 0, "792 считает объявленную дополнительную атаку")
	var pvp = _game(t, 71)
	_room24(pvp, 795)
	t.equal(pvp.g._pvp_defense16(1), 3, "795 напечатанная защита игроков3+")
	pvp.ok(0, "attack_player", {"target": 1})
	pvp.close()
	t.check(pvp.g._pvp_attacked25.has(1), "795 запомнила состоявшуюся атаку игрока")
