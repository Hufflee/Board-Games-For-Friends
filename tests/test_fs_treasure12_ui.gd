extends "res://tests/test_fs_table_runtime.gd"
## Короткая проверка UI пакета12: чужой выбор подарка и результат четырёх кубиков.
const Batch := preload("res://tests/fs/core/core_automation_batch12.gd")
const Check := preload("res://tests/fs/fs_check.gd")

func _run() -> void:
	root.size = Vector2i(1280, 720)
	net = root.get_node("Net"); net.host_offline("four_souls"); net.set_bots(1); net.start_game()
	preload("res://tests/fs_test_setup.gd").finish(net.fours)
	net.set_process(false)
	change_scene_to_file("res://games/four_souls/ui/main.tscn"); await scene_changed; await frames(15)
	table = current_scene.screen
	var batch := Batch.new()
	var s = batch._game(Check.new(), 148)
	batch._activate(s); s.choose(0, "admiration_target", {"target": 1})
	net.fours = s.g; table._turn_seen = 0; net.fs_switch_seat(1); await frames(6)
	await click(find_button("Открыть мою руку")); await frames(5)
	check(table._v.card_choices.size() == 3, "Подарок выбирает отдающий из своих трёх карт")
	await click(find_button("Выбрать цель / вариант")); await frames(5)
	var gift := find_button(str(table._v.card_choices[0]))
	check(gift != null, "Есть конкретная кнопка подарка")
	await click(gift); await frames(5)
	check(s.g.hands[0].size() == 4, "Клик отдающего автоматически передал карту")
	s = batch._game(Check.new(), 140); batch._activate(s)
	s.g._begin_resolving({"kind": "test_operation", "card": -1, "owner": 1})
	s.roll(1, [2, 5, 4]); s.ok(1, "effect_roll"); s.close()
	for index in 3: s.ok(1, "effect_roll"); s.close()
	net.fours = s.g; net.fs_switch_seat(0); await frames(6)
	await click(find_button("Открыть мою руку")); await frames(5)
	check(table._v.card_choices.size() == 4, "Контроллер выбирает один из четырёх кубиков")
	await click(find_button("Выбрать цель / вариант")); await frames(5)
	var chosen := find_button(str(table._v.card_choices[2]))
	check(chosen != null and Rect2(Vector2.ZERO, root.size).encloses(chosen.get_global_rect()), "Выбор результата помещается в720p")
	DirAccess.make_dir_recursive_absolute("res://build/shots/fs_automation04")
	await RenderingServer.frame_post_draw
	root.get_texture().get_image().save_png("res://build/shots/fs_automation04/four_dice.png")
	await click(chosen); await frames(5)
	s.close() # В стенде обработка Net отключена; закрываем штатное окно ответов.
	check(s.g.last_roll == 5, "Клик автоматически применил выбранный результат")
	current_scene.back_to_hub(); await scene_changed; await frames(8)
	print("FS TREASURE12 UI: %d проверок, %d ошибок" % [checks, errors])
	await root.get_node("Sfx").request_quit(1 if errors else 0)
