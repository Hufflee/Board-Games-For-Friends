static var _cache: Array = []


## Все вопросы: [{cat, text, answers: [{name, alts: [норм. варианты], rarity}]}].
static func all() -> Array:
	if not _cache.is_empty():
		return _cache
	var cat := ""
	var q: Dictionary = {}
	for raw in TEXT.split("\n"):
		var line := raw.strip_edges()
		if line.is_empty():
			continue
		if line.begins_with("# "):
			cat = line.substr(2)
		elif line.begins_with("? "):
			q = {"cat": cat, "text": line.substr(2), "answers": []}
			_cache.append(q)
		elif line.length() > 2 and line[1] == ":" and line[0] in RARITIES and not q.is_empty():
			for item in line.substr(2).split(","):
				var name := item.strip_edges()
				if name.ends_with("?") or name.is_empty():
					continue  # спорные варианты — пусть решает jev
				var alts: Array = []
				for alt in name.split("|"):
					var n := STJudge.normalize(alt)
					if not n.is_empty():
						alts.append(n)
				(q.answers as Array).append({"name": name.split("|")[0].strip_edges(), "alts": alts, "rarity": line[0]})
	return _cache


static func categories() -> Array:
	var r: Array = []
	for q: Dictionary in all():
		if not r.has(q.cat):
			r.append(q.cat)
	return r
