## Колода: перемешанные пары тем (по две на карту).
static func deck(adult: bool, rng: RandomNumberGenerator) -> Array:
	var src: Array = (ADULT if adult else BASE).duplicate()
	for i in range(src.size() - 1, 0, -1):
		var j := rng.randi_range(0, i)
		var t = src[i]
		src[i] = src[j]
		src[j] = t
	var cards := []
	for i in range(0, src.size() - 1, 2):
		cards.append([src[i], src[i + 1]])
	return cards
