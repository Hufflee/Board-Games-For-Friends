static func _add(result: Dictionary, edition: String, kind: String, rows: Array) -> void:
	for row: Array in rows:
		result[row[0]] = {"id": row[0], "name": row[1], "text": row[2], "edition": edition,
			"type": kind, "page": int(row[3]), "side": "evil" if kind in ["minion", "demon"] else "good"}

static func roles(edition: String, kind: String = "") -> Array:
	var found: Array = []
	for card: Dictionary in catalog().values():
		if card.edition == edition and (kind.is_empty() or card.type == kind):
			found.append(card.id)
	return found

static func handbook(edition: String = "", query: String = "") -> Array:
	var found: Array = []
	for card: Dictionary in catalog().values():
		if not edition.is_empty() and card.edition != edition:
			continue
		if not query.is_empty() and not (str(card.name) + " " + str(card.text)).to_lower().contains(query.to_lower()):
			continue
		found.append(card.duplicate(true))
	return found

static func population(count: int, selected: Array, godfather_delta: int = 0) -> Array:
	if not COUNTS.has(count):
		return []
	var out: Array = COUNTS[count].duplicate()
	var delta := 2 if selected.has("baron") else 0
	if selected.has("godfather"):
		delta += godfather_delta
	if selected.has("fang_gu"):
		delta += 1
	if selected.has("vigormortis") and int(out[1]) + delta > 0:
		delta -= 1
	out[0] -= delta
	out[1] += delta
	return out
