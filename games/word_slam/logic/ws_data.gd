const CARD_SIZES := {3: 15, 4: 21, 5: 21}  # 6 и больше — 25
const INTRO_CARDS := 10


static func standard_cards(players: int) -> int:
	return CARD_SIZES.get(players, 25)


## Колода карт-ответов: каждая — 5 слов одной сложности + «имя». intro — только зелёные.
static func build_deck(rng: RandomNumberGenerator, count: int, intro: bool) -> Array:
	var pools := {}
	for k in ANSWERS:
		var arr: Array = ANSWERS[k].duplicate()
		for i in range(arr.size() - 1, 0, -1):
			var j := rng.randi_range(0, i)
			var t = arr[i]
			arr[i] = arr[j]
			arr[j] = t
		pools[k] = arr
	var deck := []
	for c in count:
		var level := "green"
		if not intro:
			level = ["green", "yellow", "yellow", "red"][c % 4]
		var words := []
		for k in 5:
			if pools[level].is_empty():
				pools[level] = ANSWERS[level].duplicate()
			words.append(pools[level].pop_back())
		if pools["names"].is_empty():
			pools["names"] = ANSWERS["names"].duplicate()
		words.append(pools["names"].pop_back())
		deck.append({"level": level, "words": words})
	return deck
