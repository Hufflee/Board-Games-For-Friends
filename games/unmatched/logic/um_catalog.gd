# Имя и печатное значение второй атаки на той же физической карте.
const FOLLOW_UPS := {
	"achilles:03": ["Безжалостное нападение", 3],
	"bloody_mary:07": ["Кровавая реприза", 0],
	"sun_wukong:04": ["Хитрость", 4],
	"yennenga:06": ["Залп", 3],
}


static func deck_for(hero: String, seat: int) -> Array[Dictionary]:
	var deck: Array[Dictionary] = []
	for card: Array in DECKS.get(hero, []):
		var definition := "%s:%02d" % [hero, card[0]]
		for copy: int in range(card[0], card[0] + card[1]):
			deck.append({
				"key": "%d:%02d" % [seat, copy],
				"definition": definition,
				"hero": hero,
				"name": card[2],
				"kind": card[3],
				"fighter": card[4],
				"value": card[5],
				"boost": card[6],
				"face": "res://games/unmatched/art/cards/%s/%02d.webp" % [hero, copy],
			})
			if FOLLOW_UPS.has(definition):
				var follow_up: Array = FOLLOW_UPS[definition]
				deck[-1]["follow_up"] = {"name": follow_up[0], "value": follow_up[1]}
			if card.size() > 7:
				if card[7] is Dictionary:
					deck[-1].merge(card[7])
				else:
					deck[-1]["form"] = card[7]
	return deck


static func can_play(card: Dictionary, kind: Kind, is_hero: bool, form: String = "") -> bool:
	if not form.is_empty() and card.has("form") and card.form != form:
		return false
	var fighter: int = card.fighter
	if fighter != F and fighter != (H if is_hero else K):
		return false
	return card.kind == kind or (card.kind == V and kind in [A, D])
