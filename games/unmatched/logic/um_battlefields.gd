static func card(id: int) -> Dictionary:
	return {"battlefield_item": id, "key": "field_item:%d" % id, "name": ITEMS[id][0], "description": ITEMS[id][1], "value": ITEMS[id][2]}


static func complexity(arena: String) -> int:
	if POOLS.has(arena):
		return 5
	if arena in ["santa_s_workshop", "pandemonium"]:
		return 4
	if arena == "heorot":
		return 3
	if arena in ["gardens", "baskerville_manor", "king_solomon_s_mine", "the_white_house", "naglfar"]:
		return 2
	return 1 if arena in ["raptor_paddock", "kaer_morhen"] else 0


static func mechanic(arena: String) -> String:
	if POOLS.has(arena):
		return "Одноразовые предметы"
	match arena:
		"santa_s_workshop": return "Конвейер и односторонние пути"
		"pandemonium": return "Опасные пути"
		"heorot": return "Двери"
		"gardens": return "Возвышенности"
		"baskerville_manor", "king_solomon_s_mine", "the_white_house": return "Тайные ходы"
		"naglfar": return "Связи между палубами"
		"raptor_paddock", "kaer_morhen": return "Односторонние пути"
	return ""
