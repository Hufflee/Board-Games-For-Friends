const SILVER := [1, 2, 2, 3]  # за 2-е место


static func racer(id: String) -> Dictionary:
	for r in RACERS:
		if r["id"] == id:
			return r
	return {}


static func all_ids() -> Array:
	return RACERS.map(func(r): return r["id"])
