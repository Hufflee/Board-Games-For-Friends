static func catalog() -> Dictionary:
	var result := {}
	for row: Array in ROWS:
		result[row[0]] = {"id": row[0], "title": row[1], "set": row[2], "color": row[3], "icon": row[4], "rolls": row[5].duplicate(), "cost": row[6], "op": row[7], "amount": row[8], "sheet": row[9], "cell": row[10], "text": row[11], "copies": 5 if row[3] == "purple" else 6}
	return result

static func landmarks(plus: bool) -> Array:
	var result: Array = ["station", "mall", "amusement", "radio"]
	if plus:
		result.append_array(["harbor", "airport"])
	return result
