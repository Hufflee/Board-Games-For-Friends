## Слова выбранного словаря (повторы на всякий случай отбрасываются).
static func pick(kind: String) -> Array:
	if kind == "shared":
		return SharedWords.all()
	var seen := {}
	var result: Array = []
	for word: String in SIMPLE:
		if not seen.has(word):
			seen[word] = true
			result.append(word)
	return result
