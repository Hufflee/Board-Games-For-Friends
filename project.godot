; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="BoardGame Shelf"
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/Настольные игры с друзьями"
config/custom_user_dir_name.bgs_social="Godot/app_userdata/BGS Social"
config/version="0.9.1.2"
run/main_scene="res://hub/boot/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/flush_stdout_on_print=true
boot_splash/show_image=false
config/icon="res://hub/art/brand/boardgame_shelf.png"

[autoload]

Updater="*res://hub/update/updater.gd"
Diag="*res://hub/diagnostics.gd"
Prefs="*res://games/king_of_12/audio/prefs.gd"
Net="*res://games/king_of_12/net/net.gd"
Sfx="*res://games/king_of_12/audio/sfx.gd"

[debug]

file_logging/enable_file_logging=true
file_logging/max_log_files=10
settings/gdscript/always_track_call_stacks=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/borderless.bgs_social=true
window/size/always_on_top.bgs_social=true
window/size/transparent.bgs_social=true
window/per_pixel_transparency/allowed.bgs_social=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method.bgs_social="gl_compatibility"
viewport/transparent_background.bgs_social=true
