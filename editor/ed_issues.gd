const TAB_TITLES := ["Коробка", "Интерфейс", "Логика", "Элементы"]

## {hint, tab}: tab = -1, если вкладку не определить.
static func explain(text: String) -> Dictionary:
	var lower := text.to_lower()
	for rule: Array in RULES:
		if lower.contains(str(rule[0]).to_lower()):
			return {"hint": str(rule[2]), "tab": int(rule[1])}
	return {"hint": "Исправьте указанное место. Если непонятно, что не так, — отмените последние изменения (Ctrl+Z) и проверьте снова.", "tab": -1}

## Что выделить при переходе: номер цепочки (-1 — нет) и индекс колоды/карты по названию из текста (-1 — нет).
static func place(text: String, data: Dictionary) -> Dictionary:
	var result := {"chain": -1, "deck": -1}
	var chain := RegEx.create_from_string("цепочка №([0-9]+)").search(text)
	if chain != null:
		result.chain = int(chain.get_string(1)) - 1
	var deck := RegEx.create_from_string("^(Колода|Карта) «([^»]*)»").search(text)
	if deck != null:
		var decks: Array = data.get("elements", {}).get("decks", [])
		for index in decks.size():
			if str(decks[index].get("title", decks[index].get("id", ""))).left(64) == deck.get_string(2):
				result.deck = index
				break
	return result
